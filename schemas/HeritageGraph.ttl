heritageGraph:Temple a owl:Class ;
    rdfs:label "Temple"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Enshrinement ;
            owl:onProperty heritageGraph:enshrinesDeityThroughEvent ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:hasArchitecturalStyle ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:ArchitecturalStyle ;
            owl:onProperty heritageGraph:hasArchitecturalStyle ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:hasArchitecturalStyle ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:enshrinesDeityThroughEvent ],
        heritageGraph:ReligiousStructure ;
    skos:altLabel "Mandir"@en ;
    skos:broadMatch dbo:ReligiousBuilding ;
    skos:closeMatch schema1:HinduTemple,
        schema1:PlaceOfWorship ;
    skos:definition "Religious structure characterized by deity enshrinement and ritual activation. Legal designation (e.g. 'Ancient Monument' under Nepal law) is recorded per-instance via a governance assertion, not as a class criterion."@en ;
    skos:exactMatch dbo:Temple,
        aat:300007595,
        wikidata:Q44539 ;
    skos:inScheme heritageGraph:schema .

heritageGraph:WaterStructure a owl:Class ;
    rdfs:label "Water Structure"@en ;
    rdfs:subClassOf heritageGraph:ArchitecturalStructure ;
    skos:definition "Engineered water supply systems with ritual and civic significance"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:actors a owl:ObjectProperty ;
    rdfs:label "actors"@en ;
    rdfs:range crm:E39_Actor ;
    skos:definition "Collection of generic Actor instances"@en ;
