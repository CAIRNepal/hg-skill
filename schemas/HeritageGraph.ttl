    skos:inScheme heritageGraph:schema .

heritageGraph:condition_states a owl:ObjectProperty ;
    rdfs:label "Condition states"@en ;
    rdfs:range crm:E3_Condition_State ;
    skos:definition "Collection of ConditionState instances"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:consecration_events a owl:ObjectProperty ;
    rdfs:label "Consecration events"@en ;
    rdfs:range heritageGraph:Consecration ;
    skos:definition "Collection of Consecration event instances"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:custody_events a owl:ObjectProperty ;
    rdfs:label "Custody events"@en ;
    rdfs:range crm:E10_Transfer_of_Custody ;
    skos:definition "Collection of TransferOfCustody event instances"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:data_custodians a owl:ObjectProperty ;
    rdfs:label "Data custodians"@en ;
    rdfs:range heritageGraph:DataCustodian ;
    skos:definition "Collection of DataCustodian instances"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:data_sources a owl:ObjectProperty ;
    rdfs:label "Data sources"@en ;
    rdfs:range heritageGraph:DataSource ;
    skos:definition "Collection of DataSource instances"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:deities a owl:ObjectProperty ;
    rdfs:label "deities"@en ;
    rdfs:range heritageGraph:Deity ;
    skos:definition "Collection of Deity instances"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:documentation_activities a owl:ObjectProperty ;
    rdfs:label "Documentation activities"@en ;
    rdfs:range heritageGraph:DocumentationActivity ;
    skos:definition "Collection of DocumentationActivity instances"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:enshrinement_events a owl:ObjectProperty ;
    rdfs:label "Enshrinement events"@en ;
    rdfs:range heritageGraph:Enshrinement ;
    skos:definition "Collection of Enshrinement event instances"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:festivals a owl:ObjectProperty ;
    rdfs:label "festivals"@en ;
    rdfs:range heritageGraph:Festival ;
    skos:definition "Collection of Festival instances"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:guthis a owl:ObjectProperty ;
    rdfs:label "guthis"@en ;
    rdfs:range heritageGraph:Guthi ;
    skos:definition "Collection of Guthi instances"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:hasCriterion a owl:ObjectProperty ;
    rdfs:label "Has criterion"@en ;
    rdfs:range heritageGraph:SelectionCriterion ;
    skos:definition "Eligibility criterion applied in this selection."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:historical_events a owl:ObjectProperty ;
    rdfs:label "Historical events"@en ;
    rdfs:range heritageGraph:HistoricalEvent ;
    skos:definition "Collection of HistoricalEvent (incl. DestructionEvent) instances"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:human_made_objects a owl:ObjectProperty ;
    rdfs:label "Human made objects"@en ;
    rdfs:range crm:E22_Human-Made_Object ;
    skos:definition "Collection of generic HumanMadeObject instances (use structures / iconographic_objects for subclasses)"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:hypothesizedLocation a owl:ObjectProperty ;
    rdfs:label "Hypothesized location"@en ;
    rdfs:range crm:E53_Place ;
    skos:definition "Possible locations if the structure is lost"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:iconographic_objects a owl:ObjectProperty ;
    rdfs:label "Iconographic objects"@en ;
    rdfs:range heritageGraph:IconographicObject ;
    skos:definition "Collection of IconographicObject instances (incl. Murti, Paubha)"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:information_objects a owl:ObjectProperty ;
    rdfs:label "Information objects"@en ;
    rdfs:range heritageGraph:InformationObject ;
    skos:definition "Collection of InformationObject instances"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:invokesDeity a owl:ObjectProperty ;
    rdfs:label "Invokes deity"@en ;
    rdfs:range heritageGraph:Deity ;
    rdfs:subPropertyOf crm:P12_occurred_in_the_presence_of ;
    skos:definition "Deity invoked or made present through ritual"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:isInvokedInRitual a owl:ObjectProperty ;
    rdfs:label "Is invoked in ritual"@en ;
    rdfs:range heritageGraph:RitualEvent ;
    rdfs:subPropertyOf crm:P12i_was_present_at ;
    skos:definition "Rituals where this deity is invoked"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:isPrimaryForTradition a owl:ObjectProperty ;
    rdfs:label "Is primary for tradition"@en ;
    rdfs:range heritageGraph:ReligiousTradition ;
    skos:definition "Religious tradition(s) that primarily use this calendar system (e.g., Bikram Sambat for Hindu, Nepal Sambat for Newar Buddhist)"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:kumari_lifecycle_events a owl:ObjectProperty ;
    rdfs:label "Kumari lifecycle events"@en ;
    rdfs:range heritageGraph:KumariLifecycleEvent ;
    skos:definition "Collection of Kumari lifecycle events (selection, enthronement, retirement)"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:kumari_roles a owl:ObjectProperty ;
    rdfs:label "Kumari roles"@en ;
    rdfs:range heritageGraph:KumariRole ;
    skos:definition "Collection of KumariRole instances"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:kumari_tenures a owl:ObjectProperty ;
    rdfs:label "Kumari tenures"@en ;
    rdfs:range heritageGraph:KumariTenure ;
    skos:definition "Collection of KumariTenure instances"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:materials a owl:ObjectProperty ;
    rdfs:label "materials"@en ;
    rdfs:range crm:E57_Material ;
    skos:definition "Collection of Material instances"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:participatesInRitual a owl:ObjectProperty ;
    rdfs:label "Participates in ritual"@en ;
    rdfs:range heritageGraph:RitualEvent ;
    rdfs:subPropertyOf crm:P12i_was_present_at ;
    skos:definition "Rituals in which this structure participates"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:performsRitual a owl:ObjectProperty ;
    rdfs:label "Performs ritual"@en ;
    rdfs:range heritageGraph:RitualEvent ;
    rdfs:subPropertyOf crm:P14i_performed ;
    skos:definition "Rituals performed by this Guthi"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:persons a owl:ObjectProperty ;
    rdfs:label "persons"@en ;
    rdfs:range crm:E21_Person ;
    skos:definition "Collection of Person instances"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:physical_heritage_things a owl:ObjectProperty ;
    rdfs:label "Physical heritage things"@en ;
    rdfs:range heritageGraph:PhysicalHeritageThing ;
    skos:definition "Collection of all physical heritage objects"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:places a owl:ObjectProperty ;
    rdfs:label "places"@en ;
    rdfs:range crm:E53_Place ;
    skos:definition "Collection of Place instances"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:production_events a owl:ObjectProperty ;
    rdfs:label "Production events"@en ;
    rdfs:range crm:E12_Production ;
    skos:definition "Collection of Production event instances"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:propositions a owl:ObjectProperty ;
    rdfs:label "propositions"@en ;
    rdfs:range heritageGraph:Proposition ;
    skos:definition "Collection of Proposition instances referenced by assertions"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:religious_traditions a owl:ObjectProperty ;
    rdfs:label "Religious traditions"@en ;
    rdfs:range heritageGraph:ReligiousTradition ;
    skos:definition "Collection of ReligiousTradition instances"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:ritual_assessments a owl:ObjectProperty ;
    rdfs:label "Ritual assessments"@en ;
    rdfs:range heritageGraph:RitualAssessment ;
    skos:definition "Collection of RitualAssessment (e.g. FearlessnessAssessment) instances"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:ritual_events a owl:ObjectProperty ;
    rdfs:label "Ritual events"@en ;
    rdfs:range heritageGraph:RitualEvent ;
    skos:definition "Collection of RitualEvent instances"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:routePlaces a owl:ObjectProperty ;
    rdfs:label "Route places"@en ;
    rdfs:range crm:E53_Place ;
    rdfs:subPropertyOf crm:P7_took_place_at ;
    skos:definition "Ordered list of places visited during movement ritual"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:selection_criteria a owl:ObjectProperty ;
    rdfs:label "Selection criteria"@en ;
    rdfs:range heritageGraph:SelectionCriterion ;
    skos:definition "Collection of SelectionCriterion instances"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:sourceCreator a owl:ObjectProperty ;
    rdfs:label "Datacite creator"@en ;
    rdfs:range crm:E39_Actor ;
    skos:definition "Person or organization primarily responsible for creating the source"@en ;
    skos:exactMatch dcterms:creator ;
    skos:inScheme heritageGraph:schema .

heritageGraph:structures a owl:ObjectProperty ;
    rdfs:label "structures"@en ;
    rdfs:range heritageGraph:ArchitecturalStructure ;
    skos:definition "Collection of ArchitecturalStructure instances (incl. subclasses)"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:supportedByInstitution a owl:ObjectProperty ;
    rdfs:label "Supported by institution"@en ;
    rdfs:range heritageGraph:Guthi ;
    skos:definition "Institution(s) providing economic support (stipend, land endowment) or ritual support (priest salaries) for a Living Goddess during tenure. Extends Guthi role beyond structure management to person support."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:syncretic_relationships a owl:ObjectProperty ;
    rdfs:label "Syncretic relationships"@en ;
    rdfs:range heritageGraph:SyncreticRelationship ;
    skos:definition "Collection of SyncreticRelationship instances"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:techniques a owl:ObjectProperty ;
    rdfs:label "techniques"@en ;
    rdfs:range crm:E29_Design_or_Procedure ;
    skos:definition "Collection of Technique instances"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:time_spans a owl:ObjectProperty ;
    rdfs:label "Time spans"@en ;
    rdfs:range crm:E52_Time-Span ;
    skos:definition "Collection of TimeSpan instances"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:usedBy a owl:ObjectProperty ;
    rdfs:label "Used by"@en ;
    rdfs:range crm:E39_Actor ;
    skos:definition "Actor(s) who use, handle, or are responsible for this object in ritual contexts"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:usedEquipment a owl:DatatypeProperty ;
    rdfs:label "Used equipment"@en ;
    rdfs:range xsd:string ;
    skos:definition "Equipment used in documentation"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:verifiedAssertion a owl:ObjectProperty ;
    rdfs:label "Verified assertion"@en ;
    rdfs:range crminf:I2_Belief ;
    skos:definition "Assertions verified by this activity"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:verifiedByExpert a owl:ObjectProperty ;
    rdfs:label "Verified by expert"@en ;
    rdfs:range crm:E21_Person ;
    rdfs:subPropertyOf crm:P14_carried_out_by ;
    skos:definition "Expert who performed verification"@en ;
    skos:inScheme heritageGraph:schema .

crm:E10_Transfer_of_Custody a owl:Class ;
    rdfs:label "Transfer Of Custody"@en ;
    rdfs:subClassOf prov:Activity ;
    skos:definition "Event of transferring responsibility for temple maintenance, ritual performance, or artifact stewardship"@en ;
    skos:inScheme heritageGraph:schema ;
    heritageGraph:prov_alignment_note "prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM<->PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally." .

crm:E29_Design_or_Procedure a owl:Class ;
    rdfs:label "Technique"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "Method or craft process used in production or ritual"@en ;
    skos:inScheme heritageGraph:schema .

crm:E3_Condition_State a owl:Class ;
    rdfs:label "Condition State"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "A physical condition state of a heritage object"@en ;
    skos:inScheme heritageGraph:schema .

crm:P12_occurred_in_the_presence_of a owl:ObjectProperty ;
    rdfs:label "Occurred in presence of"@en ;
    skos:definition "Generic CRM presence relation (P12): entity present at an event. Canonical holder of the CRM predicate; use the specific presence slots in data."@en ;
    skos:inScheme heritageGraph:schema .

crm:P140_assigned_attribute_to a owl:ObjectProperty ;
    rdfs:label "Assigned to deity"@en ;
    skos:definition "The deity instance that is the subject of the syncretic claim."@en ;
    skos:inScheme heritageGraph:schema .

crm:P183_ends_before_the_start_of a owl:ObjectProperty ;
    rdfs:label "Occurs before"@en ;
    skos:definition "Points to the next ritual in the canonical sequence."@en ;
    skos:inScheme heritageGraph:schema .

crm:P183i_starts_after_the_end_of a owl:ObjectProperty ;
    rdfs:label "Occurs after"@en ;
    skos:definition "Points to the prerequisite ritual."@en ;
    skos:inScheme heritageGraph:schema .

crm:P46i_forms_part_of a owl:ObjectProperty ;
    rdfs:label "Is component of"@en ;
    skos:definition "Larger structure that this element is part of"@en ;
    skos:inScheme heritageGraph:schema .

crm:P62_depicts a owl:ObjectProperty ;
    rdfs:label "Depicts deity"@en ;
    skos:definition "Deity depicted iconographically (not cultic presence)"@en ;
    skos:inScheme heritageGraph:schema .

crm:P9i_forms_part_of a owl:ObjectProperty ;
    rdfs:label "Is part of festival"@en ;
    skos:definition "Larger festival this ritual is part of"@en ;
    skos:inScheme heritageGraph:schema .

prov:Agent a owl:Class ;
    rdfs:label "Agent"@en ;
    skos:definition "Direct LinkML representation of prov:Agent. Agents bear responsibility for activities or entities. PROV-O permits an individual agent also to be typed as an Entity, but does not define every Agent as a subclass of Entity."@en ;
    skos:inScheme heritageGraph:schema .

prov:generated a owl:ObjectProperty ;
    rdfs:label "generated"@en ;
    owl:inverseOf prov:wasGeneratedBy ;
    skos:definition "Entity generated by this activity."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:HistoricalEvent a owl:Class ;
    rdfs:label "Historical Event"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P7_took_place_at ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E52_Time-Span ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:architecturalStructures ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E53_Place ;
            owl:onProperty crm:P7_took_place_at ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P7_took_place_at ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:RitualEvent ;
            owl:onProperty crm:P9_consists_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:ArchitecturalStructure ;
            owl:onProperty heritageGraph:architecturalStructures ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P9_consists_of ],
        prov:Activity ;
    skos:broadMatch crm:E5_Event ;
    skos:definition "Major event affecting heritage structures or ritual life (earthquake, epidemic, political transition, fire, flood)."@en ;
    skos:inScheme heritageGraph:schema ;
    heritageGraph:prov_alignment_note "prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM<->PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally." .

heritageGraph:PhysicalHeritageThing a owl:Class ;
    rdfs:label "Physical Heritage Thing"@en ;
    rdfs:subClassOf prov:Entity ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( heritageGraph:ArchitecturalStructure heritageGraph:IconographicObject heritageGraph:ArchitecturalElement ) ] ;
    skos:definition "Union of the tangible heritage classes: architectural structures, iconographic objects, and standalone architectural elements. Used as the range of slots that apply to any physical heritage thing (production, custody, condition assessment)."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:RestHouse a owl:Class ;
    rdfs:label "Rest House"@en ;
    rdfs:subClassOf heritageGraph:ArchitecturalStructure ;
    skos:definition "Community structures for travelers and pilgrims, maintained by Guthi organizations"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:RitualAssessment a owl:Class ;
    rdfs:label "Ritual Assessment"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom crm:E52_Time-Span ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E21_Person ;
            owl:onProperty heritageGraph:assessesCandidate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:partOfSelection ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E39_Actor ;
            owl:onProperty crm:P14_carried_out_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:DocumentationActivity ;
            owl:onProperty heritageGraph:documentedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P14_carried_out_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:assessesCandidate ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:KumariSelectionEvent ;
            owl:onProperty heritageGraph:partOfSelection ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:documentedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:partOfSelection ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:assessesCandidate ],
        [ a owl:Restriction ;
            owl:allValuesFrom crminf:I2_Belief ;
            owl:onProperty heritageGraph:hasAssertion ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:hasAssertion ],
        heritageGraph:RitualEvent ;
    skos:broadMatch crm:E7_Activity,
        prov:Activity ;
    skos:definition "A performed assessment carried out during Kumari selection. Modelled as an event (not a hard criterion) so that source-specific, possibly conflicting accounts of whether/how it was conducted attach as provenanced Assertions rather than being asserted as fact."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:SyncreticRelationship a owl:Class ;
    rdfs:label "Syncretic Relationship"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Deity ;
            owl:onProperty crm:P141_assigned ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:SyncreticType ;
            owl:onProperty heritageGraph:syncreticType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:syncreticType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P140_assigned_attribute_to ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:DocumentationActivity ;
            owl:onProperty heritageGraph:documentedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:mentionedInSource ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty crm:P140_assigned_attribute_to ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:DataSource ;
            owl:onProperty heritageGraph:mentionedInSource ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:syncreticType ],
        [ a owl:Restriction ;
            owl:allValuesFrom prov:Entity ;
            owl:onProperty prov:used ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:documentedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty prov:used ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Deity ;
            owl:onProperty crm:P140_assigned_attribute_to ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty crm:P141_assigned ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P3_has_note ],
        prov:Activity ;
    skos:broadMatch crm:E13_Attribute_Assignment ;
    skos:definition "Formalizes the syncretic equivalence between divine entities across different theological frameworks. Following CIDOC CRM E13, it treats syncretism as a propositional claim with associated epistemic authority and provenance."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:assessesCandidate a owl:ObjectProperty ;
    rdfs:label "Assesses candidate"@en ;
    rdfs:range crm:E21_Person ;
    skos:definition "Candidate being assessed."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:assumesRole a owl:ObjectProperty ;
    rdfs:label "Assumes role"@en ;
    rdfs:range heritageGraph:KumariRole ;
    skos:definition "KumariRole held during this tenure."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:consecratedByEvent a owl:ObjectProperty ;
    rdfs:label "Consecrated by event"@en ;
    rdfs:range heritageGraph:Consecration ;
    owl:inverseOf crm:P16_used_specific_object ;
    skos:definition "Consecration event that activated this murti"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:curator a owl:DatatypeProperty ;
    rdfs:label "curator"@en ;
    rdfs:range xsd:string ;
    skos:definition "Person or organization curating the dataset."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:custodianType a owl:DatatypeProperty ;
    rdfs:label "Custodian type"@en ;
    rdfs:range xsd:string ;
    skos:definition "Type of custodian (government, academic, community), free text"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:dataset_name a owl:DatatypeProperty ;
    rdfs:label "Dataset name"@en ;
    rdfs:range xsd:string ;
    skos:definition "Human-readable name of the dataset."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:dataset_version a owl:DatatypeProperty ;
    rdfs:label "Dataset version"@en ;
    rdfs:range xsd:string ;
    skos:definition "Version identifier of the dataset instance."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:destructionEvent a owl:ObjectProperty ;
    rdfs:label "Destruction event"@en ;
    rdfs:range crm:E6_Destruction ;
    skos:definition "Event that destroyed this structure (if known)"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:documents a owl:ObjectProperty ;
    rdfs:label "documents"@en ;
    rdfs:range heritageGraph:AssertionSubject ;
    owl:inverseOf heritageGraph:documentedBy ;
    skos:definition "Pre-existing heritage entity or event recorded by this documentation activity (inverse of was_documented_by)."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:embodiedDeity a owl:ObjectProperty ;
    rdfs:label "Embodied deity"@en ;
    rdfs:range heritageGraph:Deity ;
    skos:definition "Deity role embodied by participant"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:endPlace a owl:ObjectProperty ;
    rdfs:label "End place"@en ;
    rdfs:range crm:E53_Place ;
    skos:definition "Ending location of movement ritual"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:enshrinesDeityThroughEvent a owl:ObjectProperty ;
    rdfs:label "Enshrines deity through event"@en ;
    rdfs:range heritageGraph:Enshrinement ;
    owl:inverseOf heritageGraph:enshrinedInStructure ;
    skos:definition "Enshrinement event that installed deity in temple"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:enthronedPerson a owl:ObjectProperty ;
    rdfs:label "Enthroned person"@en ;
    rdfs:range crm:E21_Person ;
    skos:definition "Girl enthroned as Kumari by this enthronement event."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:enthronedThrough a owl:ObjectProperty ;
    rdfs:label "Enthroned through"@en ;
    rdfs:range heritageGraph:KumariEnthronementEvent ;
    skos:definition "Enthronement event that activated this tenure."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:epochDateGregorian a owl:DatatypeProperty ;
    rdfs:label "Epoch date gregorian"@en ;
    rdfs:range xsd:string ;
    skos:definition "The start date of this calendar era in Gregorian ISO format."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:existenceStatus a owl:ObjectProperty ;
    rdfs:label "Existence status"@en ;
    rdfs:range heritageGraph:ExistenceStatus ;
    skos:definition "Current physical status of the structure"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:generated_date a owl:DatatypeProperty ;
    rdfs:label "Generated date"@en ;
    rdfs:range xsd:string ;
    skos:definition "Date the dataset serialization was generated (ISO 8601)."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:guthiType a owl:ObjectProperty ;
    rdfs:label "Guthi type"@en ;
    rdfs:range heritageGraph:GuthiType ;
    rdfs:subPropertyOf crm:P2_has_type ;
    skos:definition "Type of Guthi (Si, Jatra, Temple)"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:identifierScheme a owl:DatatypeProperty ;
    rdfs:label "Datacite identifier type"@en ;
    rdfs:range xsd:string ;
    skos:definition "Type of identifier (DOI, ISBN, Handle, LocalArchiveID)"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:isAboutDeity a owl:ObjectProperty ;
    rdfs:label "Is about deity"@en ;
    rdfs:range heritageGraph:Deity ;
    rdfs:subPropertyOf crm:P62_depicts ;
    skos:definition "Deity represented and ritually associated with the Murti"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:isCriticalForFestival a owl:DatatypeProperty ;
    rdfs:label "Is critical for festival"@en ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether this ritual is essential for the festival's completion"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:isEnshrinedThroughEvent a owl:ObjectProperty ;
    rdfs:label "Is enshrined through event"@en ;
    rdfs:range heritageGraph:Enshrinement ;
    owl:inverseOf heritageGraph:enshrinedDeity ;
    skos:definition "Events where this deity was enshrined"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:lastKnownExistenceDate a owl:DatatypeProperty ;
    rdfs:label "Last known existence date"@en ;
    rdfs:range xsd:dateTime ;
    skos:definition "Latest date when this structure is documented as existing (ISO 8601)"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:license a owl:DatatypeProperty ;
    rdfs:label "license"@en ;
    rdfs:range xsd:string ;
    skos:definition "License under which the dataset is released."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:lunarDateTithi a owl:DatatypeProperty ;
    rdfs:label "Lunar date tithi"@en ;
    rdfs:range xsd:string ;
    skos:definition "Lunar day (Tithi) for ritual timing"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:makesDeityPresent a owl:ObjectProperty ;
    rdfs:label "Makes deity present"@en ;
    rdfs:range heritageGraph:Deity ;
    skos:definition "Deity made present through consecration"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:metadata a owl:ObjectProperty ;
    rdfs:label "metadata"@en ;
    rdfs:range heritageGraph:Metadata ;
    skos:definition "Dataset metadata"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:partOfSelection a owl:ObjectProperty ;
    rdfs:label "Part of selection"@en ;
    rdfs:range heritageGraph:KumariSelectionEvent ;
    skos:definition "Selection event this assessment is part of."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:persistentIdentifier a owl:DatatypeProperty ;
    rdfs:label "Datacite identifier"@en ;
    rdfs:range xsd:string ;
    skos:definition "Persistent identifier for the source (DOI, archive ID, catalog number)"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:propositionLiteralValue a owl:DatatypeProperty ;
    rdfs:label "Proposition object literal"@en ;
    rdfs:range xsd:string ;
    skos:definition "Object of the proposition when it is a literal value (e.g. a date)."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:propositionObjectEntity a owl:ObjectProperty ;
    rdfs:label "Proposition object entity"@en ;
    rdfs:range heritageGraph:AssertionSubject ;
    skos:definition "Object of the proposition when it is a heritage entity (plays the role of rdf:object)."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:propositionPredicate a owl:DatatypeProperty ;
    rdfs:label "Proposition predicate"@en ;
    rdfs:range xsd:anyURI ;
    skos:definition "Property (URI/CURIE) claimed of the subject, e.g. crm:P108i_was_produced_by (plays the role of rdf:predicate)."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:propositionSubject a owl:ObjectProperty ;
    rdfs:label "Proposition subject"@en ;
    rdfs:range heritageGraph:AssertionSubject ;
    skos:definition "Entity the proposition is about (plays the role of rdf:subject)."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:publicationTimespan a owl:ObjectProperty ;
    rdfs:label "Publication timespan"@en ;
    rdfs:range crm:E52_Time-Span ;
    rdfs:subPropertyOf crm:P4_has_time-span ;
    skos:definition "When source was published"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:recurrencePattern a owl:DatatypeProperty ;
    rdfs:label "Recurrence pattern"@en ;
    rdfs:range xsd:string ;
    skos:definition "Frequency of recurring ritual (e.g., annual, monthly)"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:residenceStructure a owl:ObjectProperty ;
    rdfs:label "Residence structure"@en ;
    rdfs:range heritageGraph:ArchitecturalStructure ;
    skos:definition "Structure where a person resides during a specific period. For Living Goddess, this is typically a Kumari Ghar (god-house)."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:resourceType a owl:DatatypeProperty ;
    rdfs:label "Datacite resource type"@en ;
    rdfs:range xsd:string ;
    skos:definition "High-level DataCite resource type (Dataset, Text, Image, Audio, Interview)"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:ritualType a owl:ObjectProperty ;
    rdfs:label "Ritual type"@en ;
    rdfs:range heritageGraph:RitualType ;
    rdfs:subPropertyOf crm:P2_has_type ;
    skos:definition "Classification of ritual (puja, jatra, consecration)"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:roleDeity a owl:ObjectProperty ;
    rdfs:label "Role deity"@en ;
    rdfs:range heritageGraph:Deity ;
    skos:definition "Deity embodied by whoever holds this role (e.g., Taleju)."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:routeDescription a owl:DatatypeProperty ;
    rdfs:label "Route description"@en ;
    rdfs:range xsd:string ;
    skos:definition "Text description of the procession route"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:schema_version a owl:DatatypeProperty ;
    rdfs:label "Schema version"@en ;
    rdfs:range xsd:string ;
    skos:definition "HeritageGraph schema version the dataset conforms to."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:selectedPerson a owl:ObjectProperty ;
    rdfs:label "Selected person"@en ;
    rdfs:range crm:E21_Person ;
    skos:definition "Person selected through a ritual selection process to assume a sacred role or office"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:sourceCitation a owl:DatatypeProperty ;
    rdfs:label "Source citation"@en ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf crm:P3_has_note ;
    skos:definition "Formal citation of source"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:sourcePublisher a owl:ObjectProperty ;
    rdfs:label "Datacite publisher"@en ;
    rdfs:range crm:E39_Actor ;
    skos:definition "Entity responsible for making the source available"@en ;
    skos:exactMatch dcterms:publisher ;
    skos:inScheme heritageGraph:schema .

heritageGraph:sourceUrl a owl:DatatypeProperty ;
    rdfs:label "Source url"@en ;
    rdfs:range xsd:string ;
    skos:definition "URL or digital identifier for source"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:startPlace a owl:ObjectProperty ;
    rdfs:label "Start place"@en ;
    rdfs:range crm:E53_Place ;
    skos:definition "Starting location of movement ritual"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:syncreticType a owl:ObjectProperty ;
    rdfs:label "Syncretic type"@en ;
    rdfs:range heritageGraph:SyncreticType ;
    rdfs:subPropertyOf crm:P2_has_type ;
    skos:definition "The typological nature of the syncretism (e.g., Ontological Identity, Functional Overlap, Iconographic Similarity)."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:traditionalRole a owl:DatatypeProperty ;
    rdfs:label "Traditional role"@en ;
    rdfs:range xsd:string ;
    skos:definition "Hereditary occupation or ritual duty"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:usedMethod a owl:DatatypeProperty ;
    rdfs:label "Used method"@en ;
    rdfs:range xsd:string ;
    skos:definition "Documentation method used"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:verificationMethod a owl:DatatypeProperty ;
    rdfs:label "Verification method"@en ;
    rdfs:range xsd:string ;
    skos:definition "Method used for verification (cross-check, expert review, field visit)"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:yearOffsetFromGregorian a owl:DatatypeProperty ;
    rdfs:label "Year offset from gregorian"@en ;
    rdfs:range xsd:integer ;
    skos:definition "Mathematical offset to convert to Common Era (e.g., +57 for BS)."@en ;
    skos:inScheme heritageGraph:schema .

crm:E14_Condition_Assessment a owl:Class ;
    rdfs:label "Condition Assessment"@en ;
    rdfs:subClassOf prov:Activity ;
    skos:definition "Event of evaluating the physical state of a heritage object or structure"@en ;
    skos:inScheme heritageGraph:schema ;
    heritageGraph:prov_alignment_note "prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM<->PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally." .

crm:E57_Material a owl:Class ;
    rdfs:label "Material"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "Physical substance used in construction or crafting"@en ;
    skos:inScheme heritageGraph:schema .

crm:P16_used_specific_object a owl:ObjectProperty ;
    rdfs:label "Consecrated object"@en ;
    skos:definition "Murti employed in (and transformed by) the consecration ritual"@en ;
    skos:inScheme heritageGraph:schema .

crm:P8_took_place_on_or_within a owl:ObjectProperty ;
    rdfs:label "Ritual on structure"@en ;
    skos:definition "Ritual occurs at specific temple or monument"@en ;
    skos:inScheme heritageGraph:schema .

crm:P9_consists_of a owl:ObjectProperty ;
    rdfs:label "Includes ritual event"@en ;
    skos:definition "Component rituals of festival"@en ;
    skos:inScheme heritageGraph:schema .

prov:wasGeneratedBy a owl:ObjectProperty ;
    rdfs:label "Was generated by"@en ;
    owl:inverseOf prov:generated ;
    skos:definition "Activity that generated this entity."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:CalendarSystem a owl:Class ;
    rdfs:label "Calendar System"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:ReligiousTradition ;
            owl:onProperty heritageGraph:isPrimaryForTradition ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:yearOffsetFromGregorian ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:epochDateGregorian ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty heritageGraph:yearOffsetFromGregorian ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:isPrimaryForTradition ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:epochDateGregorian ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:epochDateGregorian ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:yearOffsetFromGregorian ],
        prov:Entity ;
    skos:broadMatch time:TRS ;
    skos:definition "Calendar reckoning system with conversion rules for multi-calendar temporal reasoning"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:KumariSelectionEvent a owl:Class ;
    rdfs:label "Kumari Selection Event"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:KumariTenure ;
            owl:onProperty heritageGraph:initiatedTenure ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:initiatedTenure ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:isCriticalForFestival ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:performedByGroup ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P7_took_place_at ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E53_Place ;
            owl:onProperty crm:P7_took_place_at ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:hasAssertion ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P7_took_place_at ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:documentedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty heritageGraph:isCriticalForFestival ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:selectedPerson ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E39_Actor ;
            owl:onProperty crm:P14_carried_out_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:SelectionCriterion ;
            owl:onProperty heritageGraph:hasCriterion ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P14_carried_out_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:confersRole ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:initiatedTenure ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E52_Time-Span ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:isCriticalForFestival ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:selectedPerson ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:DocumentationActivity ;
            owl:onProperty heritageGraph:documentedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( heritageGraph:Guthi heritageGraph:CasteGroup ) ] crm:E39_Actor ) ] ;
            owl:onProperty heritageGraph:performedByGroup ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E21_Person ;
            owl:onProperty heritageGraph:selectedPerson ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:hasCriterion ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:KumariRole ;
            owl:onProperty heritageGraph:confersRole ],
        [ a owl:Restriction ;
            owl:allValuesFrom crminf:I2_Belief ;
            owl:onProperty heritageGraph:hasAssertion ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:confersRole ],
        heritageGraph:KumariLifecycleEvent ;
    skos:broadMatch crm:E7_Activity,
        prov:Activity ;
    skos:definition "Tantric ritual process of selecting a new Living Goddess from eligible candidates. Involves examination of 32 auspicious physical marks (lakshana), horoscope matching with the city and ruling authority, and tests of fearlessness (e.g., remaining calm among buffalo heads and masked dancers in darkness). Performed by committee of Vajracharya priests, royal priest (Raj Jyotish), and astrologer."@en ;
    skos:inScheme heritageGraph:schema ;
    heritageGraph:prov_alignment_note "prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM<->PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally." .

heritageGraph:ReligiousStructure a owl:Class ;
    rdfs:label "Religious Structure"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:ReligiousTradition ;
            owl:onProperty heritageGraph:hasReligiousTradition ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:hasReligiousTradition ],
        heritageGraph:ArchitecturalStructure ;
    skos:definition "Architectural structure whose defining purpose is religious: enshrines a deity and/or is a locus of ritual activation. Abstract grouping for sacred structures across traditions (temple, stupa, chaitya)."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:endedTenureOf a owl:ObjectProperty ;
    rdfs:label "Ended tenure of"@en ;
    rdfs:range heritageGraph:KumariTenure ;
    rdfs:subPropertyOf heritageGraph:boundsTenure ;
    owl:inverseOf heritageGraph:retiredThrough ;
    skos:definition "Points from a KumariRetirementEvent to the tenure that it terminated. Enables reconstruction of the complete Kumari lifecycle."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:enshrinedDeity a owl:ObjectProperty ;
    rdfs:label "Enshrined deity"@en ;
    rdfs:range heritageGraph:Deity ;
    rdfs:subPropertyOf crm:P12_occurred_in_the_presence_of ;
    owl:inverseOf heritageGraph:isEnshrinedThroughEvent ;
    skos:definition "Deity installed through enshrinement"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:enshrinedInStructure a owl:ObjectProperty ;
    rdfs:label "Enshrined in structure"@en ;
    rdfs:range heritageGraph:Temple ;
    rdfs:subPropertyOf crm:P8_took_place_on_or_within ;
    owl:inverseOf heritageGraph:enshrinesDeityThroughEvent ;
    skos:definition "Temple where deity was enshrined"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:hadParticipant a owl:ObjectProperty ;
    rdfs:label "Had participant"@en ;
    rdfs:range crm:E39_Actor ;
    skos:definition "Actor(s) participating in this period, situation or ritual without carrying it out (e.g. the girl holding a Kumari tenure, or the Kumari in a chariot procession)."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:hasReligiousTradition a owl:ObjectProperty ;
    rdfs:label "Has religious tradition"@en ;
    rdfs:range heritageGraph:ReligiousTradition ;
    rdfs:subPropertyOf crm:P2_has_type ;
    skos:definition "Religious tradition(s) within which this deity is venerated, or which use this religious structure"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:initiatedTenure a owl:ObjectProperty ;
    rdfs:label "Initiated tenure"@en ;
    rdfs:range heritageGraph:KumariTenure ;
    rdfs:subPropertyOf heritageGraph:boundsTenure ;
    owl:inverseOf heritageGraph:selectedThrough ;
    skos:definition "Kumari tenure that was initiated by this selection event"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:managedByGuthi a owl:ObjectProperty ;
    rdfs:label "Managed by guthi"@en ;
    rdfs:range heritageGraph:Guthi ;
    skos:definition "Guthi organization managing this structure or ritual"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:mentionedInSource a owl:ObjectProperty ;
    rdfs:label "Documented in source"@en ;
    rdfs:range heritageGraph:DataSource ;
    skos:definition "Source(s) that mention/document this entity. Distinct from was_derived_from (which is prov:wasDerivedFrom for assertions). Entity-mention is not logical derivation."@en ;
    skos:inScheme heritageGraph:schema ;
    heritageGraph:prov_alignment "prov:wasInfluencedBy" .

heritageGraph:retiredThrough a owl:ObjectProperty ;
    rdfs:label "Retired through"@en ;
    rdfs:range heritageGraph:KumariRetirementEvent ;
    owl:inverseOf heritageGraph:endedTenureOf ;
    skos:definition "Retirement/desanctification event that ended this tenure."@en ;
    skos:inScheme heritageGraph:schema .

<https://cair-nepal.org/heritagegraph/scheme/ConditionType> a skos:ConceptScheme ;
    rdfs:label "Condition Type (concept scheme)"@en ;
    skos:definition "Controlled vocabulary for the physical condition of heritage objects and structures."@en ;
    skos:prefLabel "Condition Type"@en .

<https://cair-nepal.org/heritagegraph/scheme/SyncreticType> a skos:ConceptScheme ;
    rdfs:label "Syncretic Type (concept scheme)"@en ;
    skos:definition "Controlled vocabulary for kinds of syncretic theological relationships between deities."@en ;
    skos:prefLabel "Syncretic Type"@en .

heritageGraph:selectedThrough a owl:ObjectProperty ;
    rdfs:label "Selected through"@en ;
    rdfs:range heritageGraph:KumariSelectionEvent ;
    owl:inverseOf heritageGraph:initiatedTenure ;
    skos:definition "Selection event that initiated this tenure."@en ;
    skos:inScheme heritageGraph:schema .

crm:E12_Production a owl:Class ;
    rdfs:label "Production"@en ;
    rdfs:subClassOf prov:Activity ;
    skos:definition "Event of creating an architectural structure, murti, or paubha"@en ;
    skos:inScheme heritageGraph:schema ;
    heritageGraph:prov_alignment_note "prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM<->PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally." .

heritageGraph:ArchitecturalElement a owl:Class ;
    rdfs:label "Architectural Element"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty crm:P46i_forms_part_of ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P46i_forms_part_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:ArchitecturalStructure ;
            owl:onProperty crm:P46i_forms_part_of ],
        prov:Entity ;
    skos:broadMatch crm:E25_Human-Made_Feature ;
    skos:definition "Carved or constructed component of an architectural structure (e.g., Gajur, Torana, Tundal)"@en ;
    skos:exactMatch aat:300000885 ;
    skos:inScheme heritageGraph:schema .

heritageGraph:ConditionType a owl:Class ;
    rdfs:label "Condition Type"@en ;
    owl:oneOf ( <https://cair-nepal.org/heritagegraph/ConditionType#Good> <https://cair-nepal.org/heritagegraph/ConditionType#Damaged> <https://cair-nepal.org/heritagegraph/ConditionType#Ruined> <https://cair-nepal.org/heritagegraph/ConditionType#Restored> ) ;
    skos:definition "Controlled vocabulary for the physical condition of heritage objects and structures."@en ;
    skos:inScheme heritageGraph:schema ;
    linkml:permissible_values <https://cair-nepal.org/heritagegraph/ConditionType#Damaged>,
        <https://cair-nepal.org/heritagegraph/ConditionType#Good>,
        <https://cair-nepal.org/heritagegraph/ConditionType#Restored>,
        <https://cair-nepal.org/heritagegraph/ConditionType#Ruined> .

heritageGraph:Consecration a owl:Class ;
    rdfs:label "Consecration"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Deity ;
            owl:onProperty heritageGraph:makesDeityPresent ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P16_used_specific_object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P7_took_place_at ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E53_Place ;
            owl:onProperty crm:P7_took_place_at ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E52_Time-Span ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Murti ;
            owl:onProperty crm:P16_used_specific_object ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:makesDeityPresent ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P7_took_place_at ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P14_carried_out_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E39_Actor ;
            owl:onProperty crm:P14_carried_out_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:makesDeityPresent ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P16_used_specific_object ],
        prov:Activity ;
    skos:broadMatch crm:E7_Activity ;
    skos:definition "Ritual event that transforms an object into a sacred vessel (e.g., Prana Pratistha for Murti)"@en ;
    skos:inScheme heritageGraph:schema ;
    heritageGraph:prov_alignment_note "prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM<->PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally." .

heritageGraph:Festival a owl:Class ;
    rdfs:label "Festival"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P9_consists_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:RitualEvent ;
            owl:onProperty crm:P9_consists_of ],
        heritageGraph:RitualEvent ;
    skos:altLabel "Jatra"@en ;
    skos:broadMatch crm:E7_Activity,
        prov:Activity ;
    skos:definition "Large-scale community ritual event (Jatra) involving processions, music, and collective participation"@en ;
    skos:inScheme heritageGraph:schema ;
    heritageGraph:prov_alignment_note "prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM<->PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally." .

heritageGraph:KumariLifecycleEvent a owl:Class ;
    rdfs:label "Kumari Lifecycle Event"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:boundsTenure ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:KumariTenure ;
            owl:onProperty heritageGraph:boundsTenure ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:boundsTenure ],
        heritageGraph:RitualEvent ;
    skos:broadMatch crm:E7_Activity,
        prov:Activity ;
    skos:definition "Abstract event that bounds a KumariTenure (selection, enthronement, or retirement). Each concrete subclass requires exactly one tenure edge via slot_usage: initiated_tenure (selection), ended_tenure_of (retirement), or bounds_tenure itself (enthronement)."@en ;
    skos:inScheme heritageGraph:schema .

<https://cair-nepal.org/heritagegraph/scheme/ArchitecturalStyle> a skos:ConceptScheme ;
    rdfs:label "Architectural Style (concept scheme)"@en ;
    skos:definition "A vocabulary of architectural styles for South Asian heritage, mapped to CIDOC E55 Type."@en ;
    skos:prefLabel "Architectural Style"@en .

<https://cair-nepal.org/heritagegraph/scheme/DatePrecision> a skos:ConceptScheme ;
    rdfs:label "Date Precision (concept scheme)"@en ;
    skos:definition "Controlled vocabulary for the temporal precision of recorded heritage dates."@en ;
    skos:prefLabel "Date Precision"@en .

schema1:inLanguage a owl:DatatypeProperty ;
    rdfs:label "Source language"@en ;
    skos:definition "Language of the source material"@en ;
    skos:inScheme heritageGraph:schema .

crm:P108i_was_produced_by a owl:ObjectProperty ;
    rdfs:label "Was produced by event"@en ;
    skos:definition "Event that created this object or structure"@en ;
    skos:inScheme heritageGraph:schema .

crm:P2_has_type a owl:ObjectProperty ;
    rdfs:label "Has type"@en ;
    skos:definition "Generic CRM typing property (P2 has type). Canonical holder of the CRM predicate; use the specific typing slots below in data."@en ;
    skos:inScheme heritageGraph:schema .

crm:P55_has_current_location a owl:ObjectProperty ;
    rdfs:label "Has current location"@en ;
    skos:definition "Current location of object or structure"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:CasteGroup a owl:Class ;
    rdfs:label "Caste Group"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:traditionalRole ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:traditionalRole ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:traditionalRole ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P3_has_note ],
        crm:E39_Actor ;
    skos:broadMatch crm:E74_Group,
        prov:Organization ;
    skos:definition "Hereditary social group (Jati) with specific ritual roles and occupational duties"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:DatePrecision a owl:Class ;
    rdfs:label "Date Precision"@en ;
    owl:oneOf ( <https://cair-nepal.org/heritagegraph/DatePrecision#Exact> <https://cair-nepal.org/heritagegraph/DatePrecision#Year> <https://cair-nepal.org/heritagegraph/DatePrecision#Decade> <https://cair-nepal.org/heritagegraph/DatePrecision#Century> <https://cair-nepal.org/heritagegraph/DatePrecision#Circa> ) ;
    skos:definition "Controlled vocabulary for the temporal precision of recorded heritage dates."@en ;
    skos:inScheme heritageGraph:schema ;
    linkml:permissible_values <https://cair-nepal.org/heritagegraph/DatePrecision#Century>,
        <https://cair-nepal.org/heritagegraph/DatePrecision#Circa>,
        <https://cair-nepal.org/heritagegraph/DatePrecision#Decade>,
        <https://cair-nepal.org/heritagegraph/DatePrecision#Exact>,
        <https://cair-nepal.org/heritagegraph/DatePrecision#Year> .

heritageGraph:IconographicObject a owl:Class ;
    rdfs:label "Iconographic Object"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P108i_was_produced_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:RitualEvent ;
            owl:onProperty heritageGraph:participatesInRitual ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P55_has_current_location ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E12_Production ;
            owl:onProperty crm:P108i_was_produced_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P62_depicts ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E53_Place ;
            owl:onProperty crm:P55_has_current_location ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E39_Actor ;
            owl:onProperty heritageGraph:usedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P108i_was_produced_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P55_has_current_location ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Deity ;
            owl:onProperty crm:P62_depicts ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:usedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:participatesInRitual ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty crm:P3_has_note ],
        crm:E22_Human-Made_Object ;
    skos:broadMatch dbo:Artwork,
        crm:E22_Human-Made_Object ;
    skos:closeMatch crm:E36_Visual_Item ;
    skos:definition "Sacred visual art objects that depict or embody deities through iconographic conventions"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:SyncreticType a owl:Class ;
    rdfs:label "Syncretic Type"@en ;
    owl:oneOf ( <https://cair-nepal.org/heritagegraph/SyncreticType#Equivalence> <https://cair-nepal.org/heritagegraph/SyncreticType#Appropriation> <https://cair-nepal.org/heritagegraph/SyncreticType#Fusion> <https://cair-nepal.org/heritagegraph/SyncreticType#Historical> ) ;
    skos:definition "Controlled vocabulary for kinds of syncretic theological relationships between deities."@en ;
    skos:inScheme heritageGraph:schema ;
    linkml:permissible_values <https://cair-nepal.org/heritagegraph/SyncreticType#Appropriation>,
        <https://cair-nepal.org/heritagegraph/SyncreticType#Equivalence>,
        <https://cair-nepal.org/heritagegraph/SyncreticType#Fusion>,
        <https://cair-nepal.org/heritagegraph/SyncreticType#Historical> .

heritageGraph:confersRole a owl:ObjectProperty ;
    rdfs:label "Confers role"@en ;
    rdfs:range heritageGraph:KumariRole ;
    skos:definition "KumariRole conferred by this selection or enthronement event."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:hasArchitecturalStyle a owl:ObjectProperty ;
    rdfs:label "Has architectural style"@en ;
    rdfs:range heritageGraph:ArchitecturalStyle ;
    rdfs:subPropertyOf crm:P2_has_type ;
    skos:definition "Architectural style classification"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:performedByGroup a owl:ObjectProperty ;
    rdfs:label "Performed by group"@en ;
    rdfs:range [ owl:intersectionOf ( [ owl:unionOf ( heritageGraph:Guthi heritageGraph:CasteGroup ) ] crm:E39_Actor ) ] ;
    rdfs:subPropertyOf crm:P14_carried_out_by ;
    skos:definition "Group (Guthi, caste) responsible for ritual"@en ;
    skos:inScheme heritageGraph:schema .

<https://cair-nepal.org/heritagegraph/scheme/ExistenceStatus> a skos:ConceptScheme ;
    rdfs:label "Existence Status (concept scheme)"@en ;
    skos:definition "Controlled vocabulary for whether a heritage structure still exists physically."@en ;
    skos:prefLabel "Existence Status"@en .

crm:E22_Human-Made_Object a owl:Class ;
    rdfs:label "Human Made Object"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:closeMatch schema1:CreativeWork ;
    skos:definition "Physical objects created by human activity"@en ;
    skos:inScheme heritageGraph:schema ;
    skos:narrowMatch wikidata:Q838948 .

skos:ConceptScheme a owl:Class .

heritageGraph:Enshrinement a owl:Class ;
    rdfs:label "Enshrinement"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:enshrinedDeity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:enshrinedInStructure ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Deity ;
            owl:onProperty heritageGraph:enshrinedDeity ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E39_Actor ;
            owl:onProperty crm:P14_carried_out_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:enshrinedDeity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P7_took_place_at ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P7_took_place_at ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E53_Place ;
            owl:onProperty crm:P7_took_place_at ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Temple ;
            owl:onProperty heritageGraph:enshrinedInStructure ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E52_Time-Span ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P14_carried_out_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:enshrinedInStructure ],
        prov:Activity ;
    skos:broadMatch crm:E7_Activity ;
    skos:definition "Event of installing a deity's murti or symbol within a temple sanctum"@en ;
    skos:inScheme heritageGraph:schema ;
    heritageGraph:prov_alignment_note "prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM<->PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally." .

heritageGraph:ArchitecturalStyle a owl:Class ;
    rdfs:label "Architectural Style"@en ;
    owl:oneOf ( <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Pagoda> <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Shikhara> <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Dome> <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Chaitya> <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Stupa> ) ;
    skos:broadMatch crm:E55_Type ;
    skos:definition "A vocabulary of architectural styles for South Asian heritage, mapped to CIDOC E55 Type."@en ;
    skos:inScheme heritageGraph:schema ;
    linkml:permissible_values <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Chaitya>,
        <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Dome>,
        <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Pagoda>,
        <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Shikhara>,
        <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Stupa> .

heritageGraph:AssertionSubject a owl:Class ;
    rdfs:label "Assertion Subject"@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( crm:E22_Human-Made_Object heritageGraph:ArchitecturalElement heritageGraph:Deity heritageGraph:ReligiousTradition heritageGraph:HistoricalEvent heritageGraph:RitualEvent crm:E12_Production heritageGraph:Consecration heritageGraph:Enshrinement crm:E10_Transfer_of_Custody crm:E14_Condition_Assessment crm:E3_Condition_State crm:E39_Actor crm:E53_Place crm:E52_Time-Span heritageGraph:DataSource heritageGraph:DocumentationActivity heritageGraph:SyncreticRelationship heritageGraph:KumariTenure crm:E29_Design_or_Procedure crm:E57_Material heritageGraph:KumariRole heritageGraph:SelectionCriterion crminf:I2_Belief heritageGraph:CalendarSystem ) ] ;
    skos:broadMatch crm:E1_CRM_Entity ;
    skos:definition "Any HeritageGraph entity or event that may be the subject of an assertion."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:ExistenceStatus a owl:Class ;
    rdfs:label "Existence Status"@en ;
    owl:oneOf ( <https://cair-nepal.org/heritagegraph/ExistenceStatus#Extant> <https://cair-nepal.org/heritagegraph/ExistenceStatus#PartiallyExtant> <https://cair-nepal.org/heritagegraph/ExistenceStatus#Destroyed> <https://cair-nepal.org/heritagegraph/ExistenceStatus#Lost> <https://cair-nepal.org/heritagegraph/ExistenceStatus#Hypothetical> <https://cair-nepal.org/heritagegraph/ExistenceStatus#Unknown> ) ;
    skos:definition "Controlled vocabulary for whether a heritage structure still exists physically."@en ;
    skos:inScheme heritageGraph:schema ;
    linkml:permissible_values <https://cair-nepal.org/heritagegraph/ExistenceStatus#Destroyed>,
        <https://cair-nepal.org/heritagegraph/ExistenceStatus#Extant>,
        <https://cair-nepal.org/heritagegraph/ExistenceStatus#Hypothetical>,
        <https://cair-nepal.org/heritagegraph/ExistenceStatus#Lost>,
        <https://cair-nepal.org/heritagegraph/ExistenceStatus#PartiallyExtant>,
        <https://cair-nepal.org/heritagegraph/ExistenceStatus#Unknown> .

heritageGraph:KumariRole a owl:Class ;
    rdfs:label "Kumari Role"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Deity ;
            owl:onProperty heritageGraph:roleDeity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:roleDeity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:roleDeity ],
        prov:Entity ;
    skos:altLabel "Living Goddess"@en,
        "Royal Kumari"@en ;
    skos:broadMatch crm:E55_Type ;
    skos:definition "The role/office of Kumari (living-goddess embodiment) that a person assumes for the duration of a KumariTenure. The role is the type; the tenure is the time-bounded holding of it; the person is the holder."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:ReligiousTradition a owl:Class ;
    rdfs:label "Religious Tradition"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P3_has_note ],
        prov:Entity ;
    skos:broadMatch crm:E55_Type ;
    skos:definition "Religious or philosophical tradition (e.g., Hindu, Buddhist, Syncretic)"@en ;
    skos:exactMatch aat:300073708 ;
    skos:inScheme heritageGraph:schema .

heritageGraph:boundsTenure a owl:ObjectProperty ;
    rdfs:label "Bounds tenure"@en ;
    rdfs:range heritageGraph:KumariTenure ;
    skos:definition "The KumariTenure period that this lifecycle event bounds (initiates or terminates). Specialized by initiated_tenure (selection) and ended_tenure_of (retirement)."@en ;
    skos:inScheme heritageGraph:schema .

<https://cair-nepal.org/heritagegraph/scheme/GuthiType> a skos:ConceptScheme ;
    rdfs:label "Guthi Type (concept scheme)"@en ;
    skos:definition "Controlled vocabulary of Guthi functional types (CRM E55_Type)"@en ;
    skos:prefLabel "Guthi Type"@en .

