crm:E52_Time-Span a owl:Class ;
    rdfs:label "Time Span"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "Temporal extent of an event or period"@en ;
    skos:inScheme heritageGraph:schema .

prov:Activity a owl:Class ;
    rdfs:label "Activity"@en ;
    skos:definition "Direct LinkML representation of prov:Activity. Applied to events and processes that use, transform, generate, document, assess, or verify entities."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:documentedBy a owl:ObjectProperty ;
    rdfs:label "Was documented by"@en ;
    rdfs:range heritageGraph:DocumentationActivity ;
    rdfs:subPropertyOf prov:wasInfluencedBy ;
    owl:inverseOf heritageGraph:documents ;
    skos:definition "Documentation event that recorded this (pre-existing) entity or event. Uses heritageGraph:documentedBy (aligned to prov:wasInfluencedBy). NOTE: prov:wasGeneratedBy was incorrect: a stupa is not *generated by* the survey that records it."@en ;
    skos:inScheme heritageGraph:schema ;
    heritageGraph:prov_alignment "prov:wasInfluencedBy" .

heritageGraph:Deity a owl:Class ;
    rdfs:label "Deity"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Enshrinement ;
            owl:onProperty heritageGraph:isEnshrinedThroughEvent ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P62i_is_depicted_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:ReligiousTradition ;
            owl:onProperty heritageGraph:hasReligiousTradition ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:IconographicObject ;
            owl:onProperty crm:P62i_is_depicted_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:isInvokedInRitual ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:hasReligiousTradition ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:RitualEvent ;
            owl:onProperty heritageGraph:isInvokedInRitual ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:isEnshrinedThroughEvent ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty crm:P3_has_note ],
        prov:Entity ;
    skos:broadMatch crm:E28_Conceptual_Object ;
    skos:definition "Divine conceptual entity in Hindu, Buddhist, or syncretic traditions. Distinct from physical representations (Murti) and ritual presences."@en ;
    skos:exactMatch dbo:Deity,
        aat:300343850,
        wikidata:Q178885 ;
    skos:inScheme heritageGraph:schema .

<https://cair-nepal.org/heritagegraph/scheme/RitualType> a skos:ConceptScheme ;
    rdfs:label "Ritual Type (concept scheme)"@en ;
    skos:definition "Controlled vocabulary of ritual and festival activity types in Kathmandu Valley living heritage."@en ;
    skos:prefLabel "Ritual Type"@en .

crm:E53_Place a owl:Class ;
    rdfs:label "Place"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "Defined geographic location where events occur and structures exist"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:RitualType a owl:Class ;
    rdfs:label "Ritual Type"@en ;
    owl:oneOf ( <https://cair-nepal.org/heritagegraph/RitualType#NityaPuja> <https://cair-nepal.org/heritagegraph/RitualType#NaimittikaPuja> <https://cair-nepal.org/heritagegraph/RitualType#KamyaPuja> <https://cair-nepal.org/heritagegraph/RitualType#Abhisheka> <https://cair-nepal.org/heritagegraph/RitualType#Homa> <https://cair-nepal.org/heritagegraph/RitualType#Bhajan> <https://cair-nepal.org/heritagegraph/RitualType#Yagna> <https://cair-nepal.org/heritagegraph/RitualType#Vrata> <https://cair-nepal.org/heritagegraph/RitualType#Jatra> <https://cair-nepal.org/heritagegraph/RitualType#ChariotProcession> <https://cair-nepal.org/heritagegraph/RitualType#MaskedPerformance> <https://cair-nepal.org/heritagegraph/RitualType#RitualConsecration> <https://cair-nepal.org/heritagegraph/RitualType#ProcessionRitual> <https://cair-nepal.org/heritagegraph/RitualType#InstallationRitual> <https://cair-nepal.org/heritagegraph/RitualType#DeinstallationRitual> <https://cair-nepal.org/heritagegraph/RitualType#ReturningRitual> <https://cair-nepal.org/heritagegraph/RitualType#Circumambulation> <https://cair-nepal.org/heritagegraph/RitualType#RelicTour> <https://cair-nepal.org/heritagegraph/RitualType#ProcessionalMovement> ) ;
    skos:definition "Controlled vocabulary of ritual and festival activity types in Kathmandu Valley living heritage."@en ;
    skos:inScheme heritageGraph:schema ;
    heritageGraph:design_note "RitualType currently mixes three orthogonal axes: worship-frequency (NityaPuja/NaimittikaPuja/KamyaPuja), ritual form (Homa/Jatra/MaskedPerformance), and lifecycle (InstallationRitual/ReturningRitual). Consider splitting into RitualFrequency + RitualForm. Also: Circumambulation/ProcessionalMovement/ProcessionRitual/RelicTour overlap with RitualEvent.route_places/start_place/end_place/route_description -- pick one canonical mechanism for moving rituals." ;
    linkml:permissible_values <https://cair-nepal.org/heritagegraph/RitualType#Abhisheka>,
        <https://cair-nepal.org/heritagegraph/RitualType#Bhajan>,
        <https://cair-nepal.org/heritagegraph/RitualType#ChariotProcession>,
        <https://cair-nepal.org/heritagegraph/RitualType#Circumambulation>,
        <https://cair-nepal.org/heritagegraph/RitualType#DeinstallationRitual>,
        <https://cair-nepal.org/heritagegraph/RitualType#Homa>,
        <https://cair-nepal.org/heritagegraph/RitualType#InstallationRitual>,
        <https://cair-nepal.org/heritagegraph/RitualType#Jatra>,
        <https://cair-nepal.org/heritagegraph/RitualType#KamyaPuja>,
        <https://cair-nepal.org/heritagegraph/RitualType#MaskedPerformance>,
        <https://cair-nepal.org/heritagegraph/RitualType#NaimittikaPuja>,
        <https://cair-nepal.org/heritagegraph/RitualType#NityaPuja>,
        <https://cair-nepal.org/heritagegraph/RitualType#ProcessionRitual>,
        <https://cair-nepal.org/heritagegraph/RitualType#ProcessionalMovement>,
        <https://cair-nepal.org/heritagegraph/RitualType#RelicTour>,
        <https://cair-nepal.org/heritagegraph/RitualType#ReturningRitual>,
        <https://cair-nepal.org/heritagegraph/RitualType#RitualConsecration>,
        <https://cair-nepal.org/heritagegraph/RitualType#Vrata>,
        <https://cair-nepal.org/heritagegraph/RitualType#Yagna> .

crm:P7_took_place_at a owl:ObjectProperty ;
    rdfs:label "Took place at"@en ;
    skos:definition "Place where the event occurred"@en ;
    skos:inScheme heritageGraph:schema .

prov:Entity a owl:Class ;
    rdfs:label "Entity"@en ;
    skos:definition "Direct LinkML representation of prov:Entity. Applied to physical, digital, conceptual, and assertion-bearing things that participate in provenance relations. PROVENANCE SCOPE (design decision): for classes whose instances are real-world referents (structures, deities, places, actors), the provenance slots (was_derived_from, was_attributed_to, was_generated_by, generated_at_time) describe the DATA RECORD about the referent, not the referent itself -- a stupa is not generated by the survey that records it. Referent-level history is modelled through events (Production, DestructionEvent, etc.). RDF deployments SHOULD carry record-level provenance in named graphs or on InformationObject/Assertion nodes."@en ;
    skos:inScheme heritageGraph:schema ;
    heritageGraph:provenance_scope "record" .

crm:E39_Actor a owl:Class ;
    rdfs:label "Actor"@en ;
    rdfs:subClassOf prov:Agent ;
    skos:definition "General actor (person or group) responsible for events"@en ;
    skos:inScheme heritageGraph:schema .

crm:P4_has_time-span a owl:ObjectProperty ;
    rdfs:label "Has timespan"@en ;
    skos:definition "Links event to its temporal extent"@en ;
    skos:inScheme heritageGraph:schema .

crm:P3_has_note a owl:DatatypeProperty ;
    rdfs:label "note"@en ;
    skos:definition "Free-text note (description, reason, verification notes)"@en ;
    skos:inScheme heritageGraph:schema .

skos:Concept a owl:Class .

