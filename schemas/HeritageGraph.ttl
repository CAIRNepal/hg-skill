heritageGraph:GuthiType a owl:Class ;
    rdfs:label "Guthi Type"@en ;
    owl:oneOf ( <https://cair-nepal.org/heritagegraph/GuthiType#SiGuthi> <https://cair-nepal.org/heritagegraph/GuthiType#JatraGuthi> <https://cair-nepal.org/heritagegraph/GuthiType#PujaGuthi> <https://cair-nepal.org/heritagegraph/GuthiType#TempleGuthi> <https://cair-nepal.org/heritagegraph/GuthiType#NashaGuthi> <https://cair-nepal.org/heritagegraph/GuthiType#SanaGuthi> <https://cair-nepal.org/heritagegraph/GuthiType#SanGuthi> <https://cair-nepal.org/heritagegraph/GuthiType#RajGuthi> ) ;
    skos:definition "Controlled vocabulary of Guthi functional types (CRM E55_Type)"@en ;
    skos:inScheme heritageGraph:schema ;
    linkml:permissible_values <https://cair-nepal.org/heritagegraph/GuthiType#JatraGuthi>,
        <https://cair-nepal.org/heritagegraph/GuthiType#NashaGuthi>,
        <https://cair-nepal.org/heritagegraph/GuthiType#PujaGuthi>,
        <https://cair-nepal.org/heritagegraph/GuthiType#RajGuthi>,
        <https://cair-nepal.org/heritagegraph/GuthiType#SanGuthi>,
        <https://cair-nepal.org/heritagegraph/GuthiType#SanaGuthi>,
        <https://cair-nepal.org/heritagegraph/GuthiType#SiGuthi>,
        <https://cair-nepal.org/heritagegraph/GuthiType#TempleGuthi> .

heritageGraph:KumariTenure a owl:Class ;
    rdfs:label "Kumari Tenure"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:KumariRole ;
            owl:onProperty heritageGraph:assumesRole ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:KumariEnthronementEvent ;
            owl:onProperty heritageGraph:enthronedThrough ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:hadParticipant ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:KumariSelectionEvent ;
            owl:onProperty heritageGraph:selectedThrough ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Guthi ;
            owl:onProperty heritageGraph:supportedByInstitution ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:embodiedDeity ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:ArchitecturalStructure ;
            owl:onProperty heritageGraph:residenceStructure ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:selectedThrough ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:selectedThrough ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:retiredThrough ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:DocumentationActivity ;
            owl:onProperty heritageGraph:documentedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E52_Time-Span ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:enthronedThrough ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:KumariRetirementEvent ;
            owl:onProperty heritageGraph:retiredThrough ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:assumesRole ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:embodiedDeity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:residenceStructure ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:residenceStructure ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:supportedByInstitution ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:assumesRole ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:documentedBy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Deity ;
            owl:onProperty heritageGraph:embodiedDeity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:retiredThrough ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:enthronedThrough ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E21_Person ;
            owl:onProperty heritageGraph:hadParticipant ],
        prov:Entity ;
    skos:altLabel "Living Goddess Tenure"@en ;
    skos:broadMatch crm:E4_Period ;
    skos:definition "Time-bounded role where a person embodies a deity as Living Goddess (Kumari), residing at a specific god-house and supported by religious institutions. This class captures the unique Nepali tradition of living deity embodiment in young girls selected from Buddhist Shakya/Vajracharya families."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:SelectionCriterion a owl:Class ;
    rdfs:label "Selection Criterion"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:broadMatch crm:E55_Type ;
    skos:definition "An eligibility criterion a candidate must satisfy to assume the Kumari role. Modelled as explicit subclasses so 'what are the eligibility criteria?' is a subclass query, not free text."@en ;
    skos:inScheme heritageGraph:schema .

crm:E21_Person a owl:Class ;
    rdfs:label "Person"@en ;
    rdfs:subClassOf crm:E39_Actor ;
    skos:broadMatch prov:Person ;
    skos:definition "Individual person who performs, commissions, documents, or verifies heritage activities"@en ;
    skos:inScheme heritageGraph:schema .

crminf:I2_Belief a owl:Class ;
    rdfs:label "Assertion"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:closeMatch schema1:Claim ;
    skos:definition "A provenance-bearing belief or claim about a heritage entity or event. The assertion is represented as CRMinf I2 Belief and as a prov:Entity, allowing source, attribution, generation time, revision, confidence, and reconciliation status to be recorded explicitly."@en ;
    skos:inScheme heritageGraph:schema ;
    skos:relatedMatch prov:Entity ;
    heritageGraph:crminf_pattern "I2_Belief -J4_that-> I4_Proposition_Set; evidence via I5_Inference_Making (J1_used_as_premise / J2_concluded_that); expert re-check via I7_Belief_Adoption" .

heritageGraph:ArchitecturalStructure a owl:Class ;
    rdfs:label "Architectural Structure"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom crm:E6_Destruction ;
            owl:onProperty heritageGraph:destructionEvent ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P55_has_current_location ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty heritageGraph:lastKnownExistenceDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:existenceStatus ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:hypothesizedLocation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:existenceStatus ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:destructionEvent ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E14_Condition_Assessment ;
            owl:onProperty crm:P34i_was_assessed_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:lastKnownExistenceDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:hasArchitecturalStyle ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P46_is_composed_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E53_Place ;
            owl:onProperty crm:P55_has_current_location ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:destructionEvent ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:hasAssertion ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:ExistenceStatus ;
            owl:onProperty heritageGraph:existenceStatus ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:hasArchitecturalStyle ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:ArchitecturalStyle ;
            owl:onProperty heritageGraph:hasArchitecturalStyle ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:DataSource ;
            owl:onProperty heritageGraph:mentionedInSource ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:managedByGuthi ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P34i_was_assessed_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P108i_was_produced_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E53_Place ;
            owl:onProperty heritageGraph:hypothesizedLocation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P55_has_current_location ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:mentionedInSource ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E12_Production ;
            owl:onProperty crm:P108i_was_produced_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom crminf:I2_Belief ;
            owl:onProperty heritageGraph:hasAssertion ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:lastKnownExistenceDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P108i_was_produced_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Guthi ;
            owl:onProperty heritageGraph:managedByGuthi ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:ArchitecturalElement ;
            owl:onProperty crm:P46_is_composed_of ],
        crm:E22_Human-Made_Object ;
    skos:broadMatch crm:E22_Human-Made_Object ;
    skos:closeMatch schema1:Place ;
    skos:definition "Physical structures built for religious, social, or civic purposes. Links to events of production, use, custody, and documentation."@en ;
    skos:exactMatch wikidata:Q811979 ;
    skos:inScheme heritageGraph:schema .

heritageGraph:Guthi a owl:Class ;
    rdfs:label "Guthi"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:GuthiType ;
            owl:onProperty heritageGraph:guthiType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P50i_is_current_keeper_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:RitualEvent ;
            owl:onProperty heritageGraph:performsRitual ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P107_has_current_or_former_member ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E21_Person ;
            owl:onProperty crm:P107_has_current_or_former_member ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:ArchitecturalStructure ;
            owl:onProperty crm:P50i_is_current_keeper_of ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:performsRitual ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:guthiType ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:guthiType ],
        crm:E39_Actor ;
    skos:broadMatch crm:E74_Group,
        prov:Organization ;
    skos:definition "Endowed trust organization unique to Nepal, managing temples, rituals, and land through hereditary or voluntary membership"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:hasAssertion a owl:ObjectProperty ;
    rdfs:label "Has assertion"@en ;
    rdfs:range crminf:I2_Belief ;
    owl:inverseOf heritageGraph:assertsAbout ;
    skos:definition "Provenance-bearing assertion made about this entity or event."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:DocumentationActivity a owl:Class ;
    rdfs:label "Documentation Activity"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:allValuesFrom prov:Entity ;
            owl:onProperty prov:generated ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:usedMethod ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:usedMethod ],
        [ a owl:Restriction ;
            owl:allValuesFrom prov:Agent ;
            owl:onProperty prov:wasAssociatedWith ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:documents ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E52_Time-Span ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:usedEquipment ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:usedMethod ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty prov:generated ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty prov:wasAssociatedWith ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:usedEquipment ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:AssertionSubject ;
            owl:onProperty heritageGraph:documents ],
        prov:Activity ;
    skos:broadMatch crm:E7_Activity ;
    skos:definition "Activity that records information about a heritage entity or event and may generate information objects or assertions. It aligns CIDOC CRM documentation practices with prov:Activity."@en ;
    skos:inScheme heritageGraph:schema ;
    heritageGraph:prov_alignment_note "prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM<->PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally." .

crm:P14_carried_out_by a owl:ObjectProperty ;
    rdfs:label "Carried out by"@en ;
    skos:definition "Actor(s) who performed this event"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:RitualEvent a owl:Class ;
    rdfs:label "Ritual Event"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
