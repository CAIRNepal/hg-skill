<https://cair-nepal.org/heritagegraph/ConditionType#Damaged> a owl:NamedIndividual,
        skos:Concept,
        heritageGraph:ConditionType ;
    rdfs:label "Damaged"@en ;
    skos:definition "Partially damaged"@en ;
    skos:inScheme <https://cair-nepal.org/heritagegraph/scheme/ConditionType> ;
    skos:prefLabel "Damaged"@en .

<https://cair-nepal.org/heritagegraph/ConditionType#Good> a owl:NamedIndividual,
        skos:Concept,
        heritageGraph:ConditionType ;
    rdfs:label "Good"@en ;
    skos:definition "No significant damage"@en ;
    skos:inScheme <https://cair-nepal.org/heritagegraph/scheme/ConditionType> ;
    skos:prefLabel "Good"@en .

<https://cair-nepal.org/heritagegraph/ConditionType#Restored> a owl:NamedIndividual,
        skos:Concept,
        heritageGraph:ConditionType ;
    rdfs:label "Restored"@en ;
    skos:definition "Repaired and stabilized"@en ;
    skos:inScheme <https://cair-nepal.org/heritagegraph/scheme/ConditionType> ;
    skos:prefLabel "Restored"@en .

<https://cair-nepal.org/heritagegraph/ConditionType#Ruined> a owl:NamedIndividual,
        skos:Concept,
        heritageGraph:ConditionType ;
    rdfs:label "Ruined"@en ;
    skos:definition "Severely damaged or collapsed"@en ;
    skos:inScheme <https://cair-nepal.org/heritagegraph/scheme/ConditionType> ;
    skos:prefLabel "Ruined"@en .

heritageGraph:DataCustodian a owl:Class ;
    rdfs:label "Data Custodian"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:custodianType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:custodianType ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:custodianType ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P3_has_note ],
        crm:E39_Actor ;
    skos:broadMatch prov:Agent ;
    skos:definition "Institution or person currently responsible for stewarding heritage data."@en ;
    skos:inScheme heritageGraph:schema .

