    rdfs:label "Chaitya"@en ;
    skos:closeMatch aat:300007562 ;
    skos:definition "Buddhist votive shrine style"@en ;
    skos:inScheme <https://cair-nepal.org/heritagegraph/scheme/ArchitecturalStyle> ;
    skos:prefLabel "Chaitya"@en .

<https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Dome> a owl:NamedIndividual,
        skos:Concept,
        heritageGraph:ArchitecturalStyle ;
    rdfs:label "Dome"@en ;
    skos:definition "Dome-based style (Mughal/Neo-classical influence)"@en ;
