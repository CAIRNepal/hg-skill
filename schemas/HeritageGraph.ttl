    rdfs:label "Pati"@en ;
    rdfs:subClassOf heritageGraph:RestHouse ;
    skos:altLabel "Phalcha"@en ;
    skos:definition "Open-air pavilion for resting travelers"@en ;
    skos:inScheme heritageGraph:schema .

