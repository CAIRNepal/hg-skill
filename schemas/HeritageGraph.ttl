            owl:onProperty crm:P14_carried_out_by ],
        heritageGraph:KumariLifecycleEvent ;
    skos:broadMatch crm:E7_Activity,
        prov:Activity ;
    skos:definition "Ritual installing a selected girl into the Kumari role and residence, activating the tenure (distinct from selection, which chooses her, and retirement, which ends it)."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:KumariRetirementEvent a owl:Class ;
    rdfs:label "Kumari Retirement Event"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
