heritageGraph:Dharmashala a owl:Class ;
    rdfs:label "Dharmashala"@en ;
    rdfs:subClassOf heritageGraph:RestHouse ;
    skos:definition "Pilgrim lodge operated by a Guthi organization"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:DhungeDhara a owl:Class ;
    rdfs:label "Dhunge Dhara"@en ;
    rdfs:subClassOf heritageGraph:WaterStructure ;
    skos:altLabel "Hiti"@en ;
    skos:definition "Stone spout (hiti) with carved imagery, used for ritual bathing and daily water supply"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:FearlessnessAssessment a owl:Class ;
    rdfs:label "Fearlessness Assessment"@en ;
    rdfs:subClassOf heritageGraph:RitualAssessment ;
    skos:definition "The 'fearlessness test' popularly described (animal heads, masked dancers in darkness). Its historical and contemporary practice is DISPUTED -- some former Kumaris contest how it is described. Represented as an assessment whose accounts are source-attributed via has_assertion, NOT as a mandatory criterion."@en ;
    skos:inScheme heritageGraph:schema ;
    skos:scopeNote "Deliberately not a SelectionCriterion subclass: popular accounts and lived testimony disagree. Attach each account as a Assertion (CRMinf I2 Belief) with its own source and confidence."@en .

heritageGraph:FieldSurveyActivity a owl:Class ;
    rdfs:label "Field Survey Activity"@en ;
    rdfs:subClassOf heritageGraph:DocumentationActivity ;
    skos:broadMatch crmsci:S4_Observation ;
    skos:definition "The activity of measuring, photographing, or assessing a site in person."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:FieldSurveyDataset a owl:Class ;
    rdfs:label "Field Survey Dataset"@en ;
    rdfs:subClassOf heritageGraph:DataSource ;
    skos:broadMatch crm:E31_Document ;
    skos:definition "The structured data or report resulting from a field survey."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:HoroscopeCompatibilityCriterion a owl:Class ;
    rdfs:label "Horoscope Compatibility Criterion"@en ;
    rdfs:subClassOf heritageGraph:SelectionCriterion ;
    skos:definition "Candidate's horoscope must be compatible with the city and ruling authority."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:KumariHouse a owl:Class ;
    rdfs:label "Kumari House"@en ;
    rdfs:subClassOf heritageGraph:ReligiousStructure ;
    skos:altLabel "Kumari Ghar"@en ;
    skos:definition "God-house residence of a Kumari during tenure (e.g., Kumari Ghar, Kathmandu). Specialised ReligiousStructure."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:LineageCriterion a owl:Class ;
    rdfs:label "Lineage Criterion"@en ;
    rdfs:subClassOf heritageGraph:SelectionCriterion ;
    skos:definition "Candidate must belong to an eligible lineage (Shakya / Vajracharya Newar Buddhist family)."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:MaskedDance a owl:Class ;
    rdfs:label "Masked Dance"@en ;
    rdfs:subClassOf heritageGraph:Festival ;
    skos:definition "Festival featuring masked dancers embodying deities (e.g., Kartik Naach)"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:OralHistoryInterview a owl:Class ;
    rdfs:label "Oral History Interview"@en ;
    rdfs:subClassOf heritageGraph:DocumentationActivity ;
    skos:broadMatch crm:E65_Creation ;
    skos:definition "The interaction event between a researcher and a knowledge holder."@en ;
