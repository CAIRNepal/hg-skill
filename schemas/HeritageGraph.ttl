            owl:onProperty heritageGraph:documentedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:hadParticipant ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E53_Place ;
            owl:onProperty crm:P7_took_place_at ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P183i_starts_after_the_end_of ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:recurrencePattern ],
        [ a owl:Restriction ;
            owl:allValuesFrom crminf:I2_Belief ;
            owl:onProperty heritageGraph:hasAssertion ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:routeDescription ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:ritualType ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Festival ;
            owl:onProperty crm:P9i_forms_part_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Guthi ;
            owl:onProperty heritageGraph:managedByGuthi ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:RitualEvent ;
            owl:onProperty crm:P183_ends_before_the_start_of ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:invokesDeity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P7_took_place_at ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Deity ;
            owl:onProperty heritageGraph:invokesDeity ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:PhysicalHeritageThing ;
