        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:verifiedAssertion ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:verifiedByExpert ],
        [ a owl:Restriction ;
            owl:allValuesFrom crminf:I2_Belief ;
            owl:onProperty heritageGraph:verifiedAssertion ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:verificationMethod ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E21_Person ;
            owl:onProperty heritageGraph:verifiedByExpert ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:verificationMethod ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:verificationMethod ],
        heritageGraph:DocumentationActivity ;
    skos:broadMatch prov:Activity ;
    skos:definition "Process of cross-checking heritage claims against multiple sources"@en ;
    skos:inScheme heritageGraph:schema ;
    heritageGraph:prov_alignment_note "prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM<->PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally." .

heritageGraph:birthTimespan a owl:ObjectProperty ;
    rdfs:label "Birth timespan"@en ;
    rdfs:range crm:E52_Time-Span ;
    rdfs:subPropertyOf crm:P4_has_time-span ;
    skos:definition "Person's birth timespan"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:calendarSystem a owl:ObjectProperty ;
    rdfs:label "Calendar system"@en ;
    rdfs:range heritageGraph:CalendarSystem ;
    skos:definition "Calendar system used for date representation"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:commissionedBy a owl:ObjectProperty ;
    rdfs:label "Commissioned by"@en ;
    rdfs:range crm:E39_Actor ;
    skos:definition "Person or group who commissioned production"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:confidenceScore a owl:DatatypeProperty ;
    rdfs:label "Confidence score"@en ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:decimal ;
            owl:withRestrictions ( [ xsd:minInclusive 0.0 ] [ xsd:maxInclusive 1.0 ] ) ] ;
    skos:definition "Reliability score for assertion (0.0-1.0)"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:crminf_pattern a owl:AnnotationProperty .

heritageGraph:dataQualityNote a owl:DatatypeProperty ;
    rdfs:label "Data quality note"@en ;
    rdfs:range xsd:string ;
    skos:definition "Notes on data quality, completeness, or uncertainty"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:datePrecision a owl:ObjectProperty ;
    rdfs:label "Date precision"@en ;
    rdfs:range heritageGraph:DatePrecision ;
    skos:definition "The level of precision for a recorded date."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:deathTimespan a owl:ObjectProperty ;
    rdfs:label "Death timespan"@en ;
    rdfs:range crm:E52_Time-Span ;
    rdfs:subPropertyOf crm:P4_has_time-span ;
    skos:definition "Person's death timespan"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:design_note a owl:AnnotationProperty .

heritageGraph:expertiseArea a owl:DatatypeProperty ;
    rdfs:label "Expertise area"@en ;
    rdfs:range xsd:string ;
    skos:definition "Areas of expertise (e.g., Lichhavi inscriptions, Sanskrit epigraphy, Newari archaeology)"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:hasConditionType a owl:ObjectProperty ;
    rdfs:label "Has condition type"@en ;
    rdfs:range heritageGraph:ConditionType ;
    rdfs:subPropertyOf crm:P2_has_type ;
    skos:definition "Categorization of the condition state"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:institutionalAffiliation a owl:DatatypeProperty ;
    rdfs:label "Institutional affiliation"@en ;
    rdfs:range xsd:string ;
    skos:definition "Institutional affiliation (e.g., Tribhuvan University, Nepal Heritage Society)"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:ontology a owl:Ontology ;
    rdfs:label "HeritageGraph"@en ;
    dcterms:bibliographicCitation "Karki, N., Oli, N., Sapkota, A., Yumusak, S., & Chhetri, T. R. (2026). HeritageGraph Ontology (Version 1.0.1). CAIR-Nepal. https://doi.org/10.5281/zenodo.23435676" ;
    dcterms:created "2025-11-23"^^xsd:date ;
    dcterms:creator "Anu Sapkota",
        "Nabin Oli",
        "Niraj Karki",
        "Semih Yumusak",
        "Tek Raj Chhetri" ;
    dcterms:description "An event-centric LinkML schema for representing cultural heritage information, aligned with CIDOC-CRM and PROV-O through exact/broad mappings and subproperty bridges, enabling provenance tracking and ritual-spatial-temporal reasoning."@en ;
    dcterms:issued "2026-10-17"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-22"^^xsd:date ;
    dcterms:publisher "CAIR-Nepal" ;
    dcterms:source <https://github.com/CAIRNepal/heritagegraphontology> ;
    dcterms:title "HeritageGraph Ontology"@en ;
    bibo:doi "10.5281/zenodo.23435676" ;
    bibo:status "Published" ;
    pav:version "1.0.1" ;
    vann:preferredNamespacePrefix "heritageGraph" ;
    vann:preferredNamespaceUri "https://cair-nepal.org/heritagegraph/" ;
    owl:priorVersion <https://cair-nepal.org/heritagegraph/ontology/1.0.0> ;
    owl:versionIRI <https://cair-nepal.org/heritagegraph/ontology/1.0.1> ;
    owl:versionInfo "1.0.1" ;
    skos:definition "An event-centric LinkML schema for representing cultural heritage information, aligned with CIDOC-CRM and PROV-O through exact/broad mappings and subproperty bridges, enabling provenance tracking and ritual-spatial-temporal reasoning."@en .

heritageGraph:placeType a owl:DatatypeProperty ;
    rdfs:label "Place type"@en ;
    rdfs:range xsd:string ;
    skos:definition "Type of place (city, village, region), free text"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:prov_alignment a owl:AnnotationProperty .

heritageGraph:prov_alignment_note a owl:AnnotationProperty .

heritageGraph:provenance_scope a owl:AnnotationProperty .

heritageGraph:reconciliationStatus a owl:DatatypeProperty ;
    rdfs:label "Reconciliation status"@en ;
    rdfs:range xsd:string ;
    skos:definition "Status of multi-source reconciliation (confirmed, conflicting, unverified)"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:selectionCriteriaMet a owl:DatatypeProperty ;
    rdfs:label "Selection criteria met"@en ;
    rdfs:range xsd:string ;
    owl:deprecated true ;
    skos:definition "DEPRECATED free-text list; use has_criterion -> SelectionCriterion subclasses instead. Retained for backward compatibility."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:transferredToGuthi a owl:ObjectProperty ;
    rdfs:label "Transferred to guthi"@en ;
    rdfs:range heritageGraph:Guthi ;
    rdfs:subPropertyOf crm:P29_custody_received_by ;
    skos:definition "New custodian (Guthi)"@en ;
    skos:inScheme heritageGraph:schema .

linkml:permissible_values a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:publisher a owl:AnnotationProperty .

crm:P14i_performed a owl:ObjectProperty ;
    rdfs:label "Carried out activity"@en ;
    skos:definition "Activities performed by this actor"@en ;
    skos:inScheme heritageGraph:schema .

crm:P29_custody_received_by a owl:ObjectProperty ;
    rdfs:label "Transferred to actor"@en ;
    skos:definition "New custodian (person or group)"@en ;
    skos:inScheme heritageGraph:schema .

prov:wasInfluencedBy a owl:ObjectProperty ;
    rdfs:label "Was influenced by"@en ;
    skos:definition "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:Chaitya a owl:Class ;
    rdfs:label "Chaitya"@en ;
    rdfs:subClassOf heritageGraph:ReligiousStructure ;
    skos:definition "Buddhist votive shrine (chaitya); votive stupa form found across the Kathmandu Valley."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:Murti a owl:Class ;
    rdfs:label "Murti"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Consecration ;
            owl:onProperty heritageGraph:consecratedByEvent ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:isAboutDeity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:consecratedByEvent ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Deity ;
            owl:onProperty heritageGraph:isAboutDeity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:consecratedByEvent ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:isAboutDeity ],
        heritageGraph:IconographicObject ;
    skos:definition "Consecrated statue of a deity, ritually activated to serve as divine presence (not merely depiction)"@en ;
    skos:exactMatch wikidata:Q1781039 ;
    skos:inScheme heritageGraph:schema .

heritageGraph:assertsAbout a owl:ObjectProperty ;
    rdfs:label "Asserts about"@en ;
    rdfs:range heritageGraph:AssertionSubject ;
    owl:inverseOf heritageGraph:hasAssertion ;
    skos:definition "Heritage entity or event that is the subject of this assertion."@en ;
    skos:inScheme heritageGraph:schema .

crm:E6_Destruction a owl:Class ;
    rdfs:label "Destruction Event"@en ;
    skos:definition "Event that destroyed or damaged a structure."@en ;
    skos:inScheme heritageGraph:schema .

crm:P107_has_current_or_former_member a owl:ObjectProperty ;
    rdfs:label "Has membership"@en ;
    skos:definition "Members of Guthi organization"@en ;
    skos:inScheme heritageGraph:schema .

crm:P125_used_object_of_type a owl:ObjectProperty ;
    rdfs:label "Used materials"@en ;
    skos:definition "Ephemeral materials consumed during the ritual (e.g., oil, rice)."@en ;
    skos:inScheme heritageGraph:schema .

crm:P129_is_about a owl:ObjectProperty ;
    rdfs:label "Is about"@en ;
    skos:definition "Heritage entity or event described by this information object."@en ;
    skos:inScheme heritageGraph:schema .

crm:P12i_was_present_at a owl:ObjectProperty ;
    rdfs:label "Was present at"@en ;
    skos:definition "Generic CRM presence relation (P12i): event this entity was present at. Canonical holder of the CRM predicate; use the specific slots in data."@en ;
    skos:inScheme heritageGraph:schema .

crm:P141_assigned a owl:ObjectProperty ;
    rdfs:label "Assigned equivalent"@en ;
    skos:definition "The deity or sacred figure being identified as equivalent to the primary deity."@en ;
    skos:inScheme heritageGraph:schema .

crm:P34i_was_assessed_by a owl:ObjectProperty ;
    rdfs:label "Has condition assessment"@en ;
    skos:definition "Condition assessment events for this structure"@en ;
    skos:inScheme heritageGraph:schema .

crm:P46_is_composed_of a owl:ObjectProperty ;
    rdfs:label "Has component"@en ;
    skos:definition "Architectural elements composing structure"@en ;
    skos:inScheme heritageGraph:schema .

crm:P50i_is_current_keeper_of a owl:ObjectProperty ;
    rdfs:label "Holds custody of"@en ;
    skos:definition "Structures under Guthi custodianship"@en ;
    skos:inScheme heritageGraph:schema .

crm:P62i_is_depicted_by a owl:ObjectProperty ;
    rdfs:label "Is depicted in"@en ;
    skos:definition "Iconographic objects (murti, paubha) in which this deity is depicted."@en ;
    skos:inScheme heritageGraph:schema .

prov:used a owl:ObjectProperty ;
    rdfs:label "used"@en ;
    skos:definition "Entity used by this activity."@en ;
    skos:inScheme heritageGraph:schema .

prov:wasAssociatedWith a owl:ObjectProperty ;
    rdfs:label "Was associated with"@en ;
    skos:definition "Agent associated with responsibility for this activity."@en ;
    skos:inScheme heritageGraph:schema .

