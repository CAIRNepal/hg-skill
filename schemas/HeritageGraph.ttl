        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:endPlace ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:managedByGuthi ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E53_Place ;
            owl:onProperty heritageGraph:endPlace ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P183i_starts_after_the_end_of ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P8_took_place_on_or_within ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:startPlace ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:RitualEvent ;
            owl:onProperty crm:P183i_starts_after_the_end_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E39_Actor ;
            owl:onProperty crm:P14_carried_out_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E57_Material ;
            owl:onProperty crm:P125_used_object_of_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
