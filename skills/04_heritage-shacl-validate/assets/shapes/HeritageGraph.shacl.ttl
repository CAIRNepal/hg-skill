        [ sh:class crm:E52_Time-Span ;
            sh:description "Links event to its temporal extent" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path crm:P4_has_time-span ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dcterms:identifier ] ;
    sh:targetClass heritageGraph:Consecration .

heritageGraph:SelectionCriterion a sh:NodeShape ;
    sh:description "An eligibility criterion a candidate must satisfy to assume the Kumari role. Modelled as explicit subclasses so 'what are the eligibility criteria?' is a subclass query, not free text." ;
    sh:property [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:identifier ],
        [ sh:class prov:Entity ;
            sh:description "Entity from which this entity was derived." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 5 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:class prov:Activity ;
            sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:class prov:Agent ;
            sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path prov:wasAttributedTo ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path prov:generatedAtTime ] ;
    sh:targetClass heritageGraph:SelectionCriterion .

heritageGraph:CasteGroup a sh:NodeShape ;
    sh:description "Hereditary social group (Jati) with specific ritual roles and occupational duties" ;
    sh:property [ sh:datatype xsd:string ;
