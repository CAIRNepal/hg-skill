            sh:path prov:wasDerivedFrom ],
        [ sh:description "Architectural style classification" ;
            sh:in ( <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Pagoda> <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Shikhara> <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Dome> <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Chaitya> <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Stupa> ) ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path heritageGraph:hasArchitecturalStyle ],
        [ sh:class crm:E53_Place ;
            sh:description "Current location of object or structure" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path crm:P55_has_current_location ],
        [ sh:class heritageGraph:DataSource ;
            sh:description "Source(s) that mention/document this entity. Distinct from was_derived_from (which is prov:wasDerivedFrom for assertions). Entity-mention is not logical derivation." ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path heritageGraph:mentionedInSource ],
        [ sh:class crm:E53_Place ;
            sh:description "Possible locations if the structure is lost" ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path heritageGraph:hypothesizedLocation ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:class prov:Activity ;
            sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:class crminf:I2_Belief ;
            sh:description "Provenance-bearing assertion made about this entity or event." ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path heritageGraph:hasAssertion ],
        [ sh:class crm:E14_Condition_Assessment ;
            sh:description "Condition assessment events for this structure" ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path crm:P34i_was_assessed_by ],
        [ sh:class heritageGraph:ArchitecturalElement ;
            sh:description "Architectural elements composing structure" ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path crm:P46_is_composed_of ],
        [ sh:class crm:E6_Destruction ;
            sh:description "Event that destroyed this structure (if known)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path heritageGraph:destructionEvent ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Latest date when this structure is documented as existing (ISO 8601)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path heritageGraph:lastKnownExistenceDate ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path prov:generatedAtTime ],
        [ sh:class crm:E12_Production ;
            sh:description "Event that created this object or structure" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path crm:P108i_was_produced_by ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text note (description, reason, verification notes)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path crm:P3_has_note ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 22 ;
            sh:path prov:wasInfluencedBy ] ;
    sh:targetClass heritageGraph:ArchitecturalStructure .

heritageGraph:DataSource a sh:NodeShape ;
    sh:description "Original source from which heritage information was derived" ;
    sh:property [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Type of identifier (DOI, ISBN, Handle, LocalArchiveID)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path heritageGraph:identifierScheme ],
        [ sh:datatype xsd:string ;
            sh:description "URL or digital identifier for source" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path heritageGraph:sourceUrl ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "When source was published" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path heritageGraph:publicationTimespan ],
        [ sh:class prov:Entity ;
            sh:description "Entity from which this entity was derived." ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:class crm:E39_Actor ;
            sh:description "Person or organization primarily responsible for creating the source" ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path heritageGraph:sourceCreator ],
        [ sh:datatype xsd:string ;
            sh:description "Language of the source material" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path schema1:inLanguage ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text note (description, reason, verification notes)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path crm:P3_has_note ],
        [ sh:class prov:Agent ;
            sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path prov:wasAttributedTo ],
        [ sh:class prov:Activity ;
            sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path prov:generatedAtTime ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 16 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:datatype xsd:string ;
            sh:description "High-level DataCite resource type (Dataset, Text, Image, Audio, Interview)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path heritageGraph:resourceType ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:description "Persistent identifier for the source (DOI, archive ID, catalog number)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path heritageGraph:persistentIdentifier ],
        [ sh:datatype xsd:string ;
            sh:description "Formal citation of source" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path heritageGraph:sourceCitation ],
        [ sh:class crm:E39_Actor ;
            sh:description "Entity responsible for making the source available" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path heritageGraph:sourcePublisher ] ;
    sh:targetClass heritageGraph:DataSource .

crm:E10_Transfer_of_Custody a sh:NodeShape ;
    sh:description "Event of transferring responsibility for temple maintenance, ritual performance, or artifact stewardship" ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity started." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path prov:startedAtTime ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Links event to its temporal extent" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path crm:P4_has_time-span ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dcterms:identifier ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 12 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:class prov:Entity ;
            sh:description "Entity generated by this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path prov:generated ],
        [ sh:class crm:E39_Actor ;
            sh:description "New custodian (person or group)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path crm:P29_custody_received_by ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:description "Object transferred in custody event" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class heritageGraph:ArchitecturalStructure ] [ sh:class heritageGraph:IconographicObject ] [ sh:class heritageGraph:ArchitecturalElement ] ) ;
            sh:order 1 ;
            sh:path crm:P30_transferred_custody_of ],
        [ sh:class crm:E53_Place ;
            sh:description "Place where the event occurred" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path crm:P7_took_place_at ],
        [ sh:class prov:Entity ;
            sh:description "Entity used by this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path prov:used ],
        [ sh:class heritageGraph:Guthi ;
            sh:description "New custodian (Guthi)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path heritageGraph:transferredToGuthi ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity ended." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path prov:endedAtTime ],
        [ sh:class prov:Activity ;
            sh:description "Activity that informed this activity; PROV-O uses this when the intervening generated and used entity is unknown or omitted." ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path prov:wasInformedBy ],
        [ sh:class crm:E39_Actor ;
            sh:description "Previous custodian" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path crm:P28_custody_surrendered_by ],
        [ sh:class prov:Agent ;
            sh:description "Agent associated with responsibility for this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path prov:wasAssociatedWith ] ;
    sh:targetClass crm:E10_Transfer_of_Custody .

crm:E12_Production a sh:NodeShape ;
    sh:description "Event of creating an architectural structure, murti, or paubha" ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity started." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path prov:startedAtTime ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path dcterms:identifier ],
        [ sh:class crm:E53_Place ;
            sh:description "Place where the event occurred" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path crm:P7_took_place_at ],
        [ sh:class heritageGraph:DocumentationActivity ;
            sh:description "Documentation event that recorded this (pre-existing) entity or event. Uses heritageGraph:documentedBy (aligned to prov:wasInfluencedBy). NOTE: prov:wasGeneratedBy was incorrect: a stupa is not *generated by* the survey that records it." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path heritageGraph:documentedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity ended." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path prov:endedAtTime ],
        [ sh:description "Object produced by this production event" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class heritageGraph:ArchitecturalStructure ] [ sh:class heritageGraph:IconographicObject ] [ sh:class heritageGraph:ArchitecturalElement ] ) ;
            sh:order 1 ;
            sh:path crm:P108_has_produced ],
        [ sh:class prov:Activity ;
            sh:description "Activity that informed this activity; PROV-O uses this when the intervening generated and used entity is unknown or omitted." ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path prov:wasInformedBy ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 14 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:class prov:Entity ;
            sh:description "Entity used by this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path prov:used ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor(s) who performed this event" ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path crm:P14_carried_out_by ],
        [ sh:class prov:Entity ;
            sh:description "Entity generated by this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path prov:generated ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:class crm:E29_Design_or_Procedure ;
            sh:description "Craft technique used in production" ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path crm:P33_used_specific_technique ],
        [ sh:class prov:Agent ;
            sh:description "Agent associated with responsibility for this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:class crminf:I2_Belief ;
            sh:description "Provenance-bearing assertion made about this entity or event." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path heritageGraph:hasAssertion ],
        [ sh:class crm:E39_Actor ;
            sh:description "Person or group who commissioned production" ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path heritageGraph:commissionedBy ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Links event to its temporal extent" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path crm:P4_has_time-span ] ;
    sh:targetClass crm:E12_Production .

crm:E14_Condition_Assessment a sh:NodeShape ;
    sh:description "Event of evaluating the physical state of a heritage object or structure" ;
    sh:property [ sh:class prov:Activity ;
            sh:description "Activity that informed this activity; PROV-O uses this when the intervening generated and used entity is unknown or omitted." ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path prov:wasInformedBy ],
        [ sh:description "Object assessed for condition" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class heritageGraph:ArchitecturalStructure ] [ sh:class heritageGraph:IconographicObject ] [ sh:class heritageGraph:ArchitecturalElement ] ) ;
            sh:order 1 ;
            sh:path crm:P34_concerned ],
        [ sh:class prov:Entity ;
            sh:description "Entity used by this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path prov:used ],
        [ sh:class crm:E3_Condition_State ;
            sh:description "Condition state identified by the assessment" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path crm:P35_has_identified ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity started." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path prov:startedAtTime ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor(s) who performed this event" ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path crm:P14_carried_out_by ],
        [ sh:class prov:Agent ;
            sh:description "Agent associated with responsibility for this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 10 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dcterms:identifier ],
        [ sh:class prov:Entity ;
            sh:description "Entity generated by this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path prov:generated ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity ended." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path prov:endedAtTime ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Links event to its temporal extent" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path crm:P4_has_time-span ] ;
    sh:targetClass crm:E14_Condition_Assessment .

heritageGraph:Deity a sh:NodeShape ;
    sh:description "Divine conceptual entity in Hindu, Buddhist, or syncretic traditions. Distinct from physical representations (Murti) and ritual presences." ;
    sh:property [ sh:class heritageGraph:RitualEvent ;
            sh:description "Rituals where this deity is invoked" ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path heritageGraph:isInvokedInRitual ],
        [ sh:class heritageGraph:IconographicObject ;
            sh:description "Iconographic objects (murti, paubha) in which this deity is depicted." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path crm:P62i_is_depicted_by ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text note (description, reason, verification notes)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path crm:P3_has_note ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path prov:generatedAtTime ],
        [ sh:class heritageGraph:Enshrinement ;
            sh:description "Events where this deity was enshrined" ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path heritageGraph:isEnshrinedThroughEvent ],
        [ sh:class prov:Activity ;
            sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:class heritageGraph:ReligiousTradition ;
            sh:description "Religious tradition(s) within which this deity is venerated, or which use this religious structure" ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path heritageGraph:hasReligiousTradition ],
        [ sh:class prov:Agent ;
            sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path prov:wasAttributedTo ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 11 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:class prov:Entity ;
            sh:description "Entity from which this entity was derived." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ] ;
    sh:targetClass heritageGraph:Deity .

crminf:I2_Belief a sh:NodeShape ;
    sh:description "A provenance-bearing belief or claim about a heritage entity or event. The assertion is represented as CRMinf I2 Belief and as a prov:Entity, allowing source, attribution, generation time, revision, confidence, and reconciliation status to be recorded explicitly." ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Status of multi-source reconciliation (confirmed, conflicting, unverified)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path heritageGraph:reconciliationStatus ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path dcterms:identifier ],
        [ sh:class heritageGraph:DocumentationActivity ;
            sh:description "Documentation activity that generated the assertion." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:datatype xsd:decimal ;
            sh:description "Reliability score for assertion (0.0-1.0)" ;
            sh:maxCount 1 ;
            sh:maxInclusive 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path heritageGraph:confidenceScore ],
        [ sh:datatype xsd:string ;
            sh:description "The factual claim being asserted" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path prov:value ],
        [ sh:class crminf:I2_Belief ;
            sh:description "Previous assertion that this one revises (version chain A1->A2->A3). Uses prov:wasRevisionOf (a derivation between entities); the latest assertion is the one with no incoming wasRevisionOf. NOTE: prov:invalidated was incorrect here (it is an Activity->Entity relation, not Entity->Entity)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path prov:wasRevisionOf ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 12 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:description "Heritage entity or event that is the subject of this assertion." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:or ( [ sh:class crm:E22_Human-Made_Object ] [ sh:class heritageGraph:ArchitecturalElement ] [ sh:class heritageGraph:Deity ] [ sh:class heritageGraph:ReligiousTradition ] [ sh:class heritageGraph:HistoricalEvent ] [ sh:class heritageGraph:RitualEvent ] [ sh:class crm:E12_Production ] [ sh:class heritageGraph:Consecration ] [ sh:class heritageGraph:Enshrinement ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E39_Actor ] [ sh:class crm:E53_Place ] [ sh:class crm:E52_Time-Span ] [ sh:class heritageGraph:DataSource ] [ sh:class heritageGraph:DocumentationActivity ] [ sh:class heritageGraph:SyncreticRelationship ] [ sh:class heritageGraph:KumariTenure ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E57_Material ] [ sh:class heritageGraph:KumariRole ] [ sh:class heritageGraph:SelectionCriterion ] [ sh:class crminf:I2_Belief ] [ sh:class heritageGraph:CalendarSystem ] ) ;
            sh:order 2 ;
            sh:path heritageGraph:assertsAbout ],
        [ sh:datatype xsd:string ;
            sh:description "Notes on data quality, completeness, or uncertainty" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path heritageGraph:dataQualityNote ],
        [ sh:class heritageGraph:Proposition ;
            sh:description "Machine-readable proposition(s) this assertion holds to be true (CRMinf J4 that). Complements the free-text assertion_content." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path crminf:J4_that ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path prov:generatedAtTime ],
        [ sh:class heritageGraph:DataSource ;
            sh:description "Source entities from which this assertion was derived." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:class prov:Agent ;
            sh:description "Agent to whom the assertion is attributed." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path prov:wasAttributedTo ] ;
    sh:targetClass crminf:I2_Belief .

heritageGraph:ArchitecturalElement a sh:NodeShape ;
    sh:description "Carved or constructed component of an architectural structure (e.g., Gajur, Torana, Tundal)" ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path prov:generatedAtTime ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:class prov:Entity ;
            sh:description "Entity from which this entity was derived." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dcterms:identifier ],
        [ sh:class prov:Agent ;
            sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path prov:wasAttributedTo ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text note (description, reason, verification notes)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path crm:P3_has_note ],
        [ sh:class heritageGraph:ArchitecturalStructure ;
            sh:description "Larger structure that this element is part of" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path crm:P46i_forms_part_of ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 8 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:class prov:Activity ;
            sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path prov:wasGeneratedBy ] ;
    sh:targetClass heritageGraph:ArchitecturalElement .

heritageGraph:Guthi a sh:NodeShape ;
    sh:description "Endowed trust organization unique to Nepal, managing temples, rituals, and land through hereditary or voluntary membership" ;
    sh:property [ sh:class heritageGraph:ArchitecturalStructure ;
            sh:description "Structures under Guthi custodianship" ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path crm:P50i_is_current_keeper_of ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 8 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text note (description, reason, verification notes)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path crm:P3_has_note ],
        [ sh:class prov:Agent ;
            sh:description "Agent on whose behalf this agent acted." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path prov:actedOnBehalfOf ],
        [ sh:description "Type of Guthi (Si, Jatra, Temple)" ;
            sh:in ( <https://cair-nepal.org/heritagegraph/GuthiType#SiGuthi> <https://cair-nepal.org/heritagegraph/GuthiType#JatraGuthi> <https://cair-nepal.org/heritagegraph/GuthiType#PujaGuthi> <https://cair-nepal.org/heritagegraph/GuthiType#TempleGuthi> <https://cair-nepal.org/heritagegraph/GuthiType#NashaGuthi> <https://cair-nepal.org/heritagegraph/GuthiType#SanaGuthi> <https://cair-nepal.org/heritagegraph/GuthiType#SanGuthi> <https://cair-nepal.org/heritagegraph/GuthiType#RajGuthi> ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path heritageGraph:guthiType ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dcterms:identifier ],
        [ sh:class crm:E21_Person ;
            sh:description "Members of Guthi organization" ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path crm:P107_has_current_or_former_member ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:class heritageGraph:RitualEvent ;
            sh:description "Rituals performed by this Guthi" ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path heritageGraph:performsRitual ] ;
    sh:targetClass heritageGraph:Guthi .

crm:E52_Time-Span a sh:NodeShape ;
    sh:description "Temporal extent of an event or period" ;
    sh:property [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 9 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Earliest possible date (for uncertain dates)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path crm:P82a_begin_of_the_begin ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Latest possible date (for uncertain dates)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path crm:P82b_end_of_the_end ],
        [ sh:class prov:Activity ;
            sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:description "The level of precision for a recorded date." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/DatePrecision#Exact> <https://cair-nepal.org/heritagegraph/DatePrecision#Year> <https://cair-nepal.org/heritagegraph/DatePrecision#Decade> <https://cair-nepal.org/heritagegraph/DatePrecision#Century> <https://cair-nepal.org/heritagegraph/DatePrecision#Circa> ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path heritageGraph:datePrecision ],
        [ sh:class prov:Entity ;
            sh:description "Entity from which this entity was derived." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:class heritageGraph:CalendarSystem ;
            sh:description "Calendar system used for date representation" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path heritageGraph:calendarSystem ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dcterms:identifier ],
        [ sh:class prov:Agent ;
            sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path prov:wasAttributedTo ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path prov:generatedAtTime ] ;
    sh:targetClass crm:E52_Time-Span .

heritageGraph:DocumentationActivity a sh:NodeShape ;
    sh:description "Activity that records information about a heritage entity or event and may generate information objects or assertions. It aligns CIDOC CRM documentation practices with prov:Activity." ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Equipment used in documentation" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path heritageGraph:usedEquipment ],
        [ sh:class prov:Entity ;
            sh:description "Entity generated by this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path prov:generated ],
        [ sh:description "Pre-existing heritage entity or event recorded by this documentation activity (inverse of was_documented_by)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:or ( [ sh:class crm:E22_Human-Made_Object ] [ sh:class heritageGraph:ArchitecturalElement ] [ sh:class heritageGraph:Deity ] [ sh:class heritageGraph:ReligiousTradition ] [ sh:class heritageGraph:HistoricalEvent ] [ sh:class heritageGraph:RitualEvent ] [ sh:class crm:E12_Production ] [ sh:class heritageGraph:Consecration ] [ sh:class heritageGraph:Enshrinement ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E39_Actor ] [ sh:class crm:E53_Place ] [ sh:class crm:E52_Time-Span ] [ sh:class heritageGraph:DataSource ] [ sh:class heritageGraph:DocumentationActivity ] [ sh:class heritageGraph:SyncreticRelationship ] [ sh:class heritageGraph:KumariTenure ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E57_Material ] [ sh:class heritageGraph:KumariRole ] [ sh:class heritageGraph:SelectionCriterion ] [ sh:class crminf:I2_Belief ] [ sh:class heritageGraph:CalendarSystem ] ) ;
            sh:order 1 ;
            sh:path heritageGraph:documents ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity started." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path prov:startedAtTime ],
        [ sh:class prov:Activity ;
            sh:description "Activity that informed this activity; PROV-O uses this when the intervening generated and used entity is unknown or omitted." ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path prov:wasInformedBy ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:class prov:Entity ;
            sh:description "Entity used by this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path prov:used ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 10 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity ended." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path prov:endedAtTime ],
        [ sh:datatype xsd:string ;
            sh:description "Documentation method used" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path heritageGraph:usedMethod ],
        [ sh:class prov:Agent ;
            sh:description "Agent associated with responsibility for this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dcterms:identifier ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Links event to its temporal extent" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path crm:P4_has_time-span ] ;
    sh:targetClass heritageGraph:DocumentationActivity .

crm:E39_Actor a sh:NodeShape ;
    sh:description "General actor (person or group) responsible for events" ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Free-text note (description, reason, verification notes)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path crm:P3_has_note ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:identifier ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 4 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:class prov:Agent ;
            sh:description "Agent on whose behalf this agent acted." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path prov:actedOnBehalfOf ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ] ;
    sh:targetClass crm:E39_Actor .

heritageGraph:RitualEvent a sh:NodeShape ;
    sh:description "Intentional ritual activity that activates sacred space, invokes deities, and binds social groups" ;
    sh:property [ sh:class crm:E53_Place ;
            sh:description "Place where the event occurred" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path crm:P7_took_place_at ],
        [ sh:class prov:Entity ;
            sh:description "Entity generated by this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 25 ;
            sh:path prov:generated ],
        [ sh:description "Ritual occurs at specific temple or monument" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class heritageGraph:ArchitecturalStructure ] [ sh:class heritageGraph:IconographicObject ] [ sh:class heritageGraph:ArchitecturalElement ] ) ;
            sh:order 3 ;
            sh:path crm:P8_took_place_on_or_within ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Links event to its temporal extent" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path crm:P4_has_time-span ],
        [ sh:class heritageGraph:RitualEvent ;
            sh:description "Points to the prerequisite ritual." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path crm:P183i_starts_after_the_end_of ],
        [ sh:class crm:E53_Place ;
            sh:description "Ordered list of places visited during movement ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path heritageGraph:routePlaces ],
        [ sh:datatype xsd:string ;
            sh:description "Text description of the procession route" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path heritageGraph:routeDescription ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 28 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity started." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 29 ;
            sh:path prov:startedAtTime ],
        [ sh:class heritageGraph:DocumentationActivity ;
            sh:description "Documentation event that recorded this (pre-existing) entity or event. Uses heritageGraph:documentedBy (aligned to prov:wasInfluencedBy). NOTE: prov:wasGeneratedBy was incorrect: a stupa is not *generated by* the survey that records it." ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path heritageGraph:documentedBy ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:class heritageGraph:RitualEvent ;
            sh:description "Points to the next ritual in the canonical sequence." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path crm:P183_ends_before_the_start_of ],
        [ sh:description "Classification of ritual (puja, jatra, consecration)" ;
            sh:in ( <https://cair-nepal.org/heritagegraph/RitualType#NityaPuja> <https://cair-nepal.org/heritagegraph/RitualType#NaimittikaPuja> <https://cair-nepal.org/heritagegraph/RitualType#KamyaPuja> <https://cair-nepal.org/heritagegraph/RitualType#Abhisheka> <https://cair-nepal.org/heritagegraph/RitualType#Homa> <https://cair-nepal.org/heritagegraph/RitualType#Bhajan> <https://cair-nepal.org/heritagegraph/RitualType#Yagna> <https://cair-nepal.org/heritagegraph/RitualType#Vrata> <https://cair-nepal.org/heritagegraph/RitualType#Jatra> <https://cair-nepal.org/heritagegraph/RitualType#ChariotProcession> <https://cair-nepal.org/heritagegraph/RitualType#MaskedPerformance> <https://cair-nepal.org/heritagegraph/RitualType#RitualConsecration> <https://cair-nepal.org/heritagegraph/RitualType#ProcessionRitual> <https://cair-nepal.org/heritagegraph/RitualType#InstallationRitual> <https://cair-nepal.org/heritagegraph/RitualType#DeinstallationRitual> <https://cair-nepal.org/heritagegraph/RitualType#ReturningRitual> <https://cair-nepal.org/heritagegraph/RitualType#Circumambulation> <https://cair-nepal.org/heritagegraph/RitualType#RelicTour> <https://cair-nepal.org/heritagegraph/RitualType#ProcessionalMovement> ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path heritageGraph:ritualType ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity ended." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 30 ;
            sh:path prov:endedAtTime ],
        [ sh:class prov:Activity ;
            sh:description "Activity that informed this activity; PROV-O uses this when the intervening generated and used entity is unknown or omitted." ;
            sh:nodeKind sh:IRI ;
            sh:order 27 ;
            sh:path prov:wasInformedBy ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path dcterms:identifier ],
        [ sh:class crminf:I2_Belief ;
            sh:description "Provenance-bearing assertion made about this entity or event." ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path heritageGraph:hasAssertion ],
        [ sh:class crm:E53_Place ;
            sh:description "Starting location of movement ritual" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path heritageGraph:startPlace ],
        [ sh:class prov:Agent ;
            sh:description "Agent associated with responsibility for this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 26 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:class crm:E57_Material ;
            sh:description "Ephemeral materials consumed during the ritual (e.g., oil, rice)." ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path crm:P125_used_object_of_type ],
        [ sh:description "Group (Guthi, caste) responsible for ritual" ;
            sh:or ( [ sh:class heritageGraph:Guthi ] [ sh:class heritageGraph:CasteGroup ] ) ;
            sh:order 11 ;
            sh:path heritageGraph:performedByGroup ],
        [ sh:class heritageGraph:Deity ;
            sh:description "Deity invoked or made present through ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path heritageGraph:invokesDeity ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor(s) participating in this period, situation or ritual without carrying it out (e.g. the girl holding a Kumari tenure, or the Kumari in a chariot procession)." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path heritageGraph:hadParticipant ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text note (description, reason, verification notes)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path crm:P3_has_note ],
        [ sh:datatype xsd:string ;
            sh:description "Frequency of recurring ritual (e.g., annual, monthly)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path heritageGraph:recurrencePattern ],
        [ sh:class heritageGraph:Guthi ;
            sh:description "Guthi organization managing this structure or ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path heritageGraph:managedByGuthi ],
        [ sh:class heritageGraph:Festival ;
            sh:description "Larger festival this ritual is part of" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path crm:P9i_forms_part_of ],
        [ sh:class prov:Entity ;
            sh:description "Entity used by this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 24 ;
            sh:path prov:used ],
        [ sh:datatype xsd:string ;
            sh:description "Lunar day (Tithi) for ritual timing" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path heritageGraph:lunarDateTithi ],
        [ sh:class crm:E53_Place ;
            sh:description "Ending location of movement ritual" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path heritageGraph:endPlace ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor(s) who performed this event" ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path crm:P14_carried_out_by ] ;
    sh:targetClass heritageGraph:RitualEvent .

crm:E53_Place a sh:NodeShape ;
    sh:description "Defined geographic location where events occur and structures exist" ;
    sh:property [ sh:class prov:Activity ;
            sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:datatype xsd:string ;
            sh:description "Type of place (city, village, region), free text" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path heritageGraph:placeType ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dcterms:identifier ],
        [ sh:datatype geo:wktLiteral ;
            sh:description "Coordinates as WKT literal" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path geo:asWKT ],
        [ sh:class prov:Agent ;
            sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path prov:wasAttributedTo ],
        [ sh:class prov:Entity ;
            sh:description "Entity from which this entity was derived." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path prov:generatedAtTime ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 9 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:class heritageGraph:ArchitecturalStructure ;
            sh:description "Structures located in this place" ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path crm:P53i_is_former_or_current_location_of ] ;
    sh:targetClass crm:E53_Place .

prov:Activity a sh:NodeShape ;
    sh:description "Direct LinkML representation of prov:Activity. Applied to events and processes that use, transform, generate, document, assess, or verify entities." ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity ended." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path prov:endedAtTime ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 5 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:class prov:Activity ;
            sh:description "Activity that informed this activity; PROV-O uses this when the intervening generated and used entity is unknown or omitted." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path prov:wasInformedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity started." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path prov:startedAtTime ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:identifier ],
        [ sh:class prov:Entity ;
            sh:description "Entity generated by this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path prov:generated ],
        [ sh:class prov:Agent ;
            sh:description "Agent associated with responsibility for this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:class prov:Entity ;
            sh:description "Entity used by this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path prov:used ] ;
    sh:targetClass prov:Activity .

prov:Agent a sh:NodeShape ;
    sh:description "Direct LinkML representation of prov:Agent. Agents bear responsibility for activities or entities. PROV-O permits an individual agent also to be typed as an Entity, but does not define every Agent as a subclass of Entity." ;
    sh:property [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:identifier ],
        [ sh:class prov:Agent ;
            sh:description "Agent on whose behalf this agent acted." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path prov:actedOnBehalfOf ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 2 ;
            sh:path prov:wasInfluencedBy ] ;
    sh:targetClass prov:Agent .

prov:Entity a sh:NodeShape ;
    sh:description "Direct LinkML representation of prov:Entity. Applied to physical, digital, conceptual, and assertion-bearing things that participate in provenance relations. PROVENANCE SCOPE (design decision): for classes whose instances are real-world referents (structures, deities, places, actors), the provenance slots (was_derived_from, was_attributed_to, was_generated_by, generated_at_time) describe the DATA RECORD about the referent, not the referent itself -- a stupa is not generated by the survey that records it. Referent-level history is modelled through events (Production, DestructionEvent, etc.). RDF deployments SHOULD carry record-level provenance in named graphs or on InformationObject/Assertion nodes." ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path prov:generatedAtTime ],
        [ sh:class prov:Activity ;
            sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:identifier ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 5 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:class prov:Agent ;
            sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path prov:wasAttributedTo ],
        [ sh:class prov:Entity ;
            sh:description "Entity from which this entity was derived." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path prov:wasDerivedFrom ] ;
    sh:targetClass prov:Entity .

