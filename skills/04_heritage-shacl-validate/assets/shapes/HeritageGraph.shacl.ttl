heritageGraph:FearlessnessAssessment a sh:NodeShape ;
    sh:description "The 'fearlessness test' popularly described (animal heads, masked dancers in darkness). Its historical and contemporary practice is DISPUTED -- some former Kumaris contest how it is described. Represented as an assessment whose accounts are source-attributed via has_assertion, NOT as a mandatory criterion." ;
    sh:property [ sh:class prov:Entity ;
            sh:description "Entity used by this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 26 ;
            sh:path prov:used ],
        [ sh:datatype xsd:string ;
            sh:description "Lunar day (Tithi) for ritual timing" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path heritageGraph:lunarDateTithi ],
        [ sh:class crm:E53_Place ;
            sh:description "Ending location of movement ritual" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 23 ;
            sh:path heritageGraph:endPlace ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path rdfs:label ],
        [ sh:description "Ritual occurs at specific temple or monument" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class heritageGraph:ArchitecturalStructure ] [ sh:class heritageGraph:IconographicObject ] [ sh:class heritageGraph:ArchitecturalElement ] ) ;
            sh:order 9 ;
            sh:path crm:P8_took_place_on_or_within ],
        [ sh:description "Classification of ritual (puja, jatra, consecration)" ;
            sh:in ( <https://cair-nepal.org/heritagegraph/RitualType#NityaPuja> <https://cair-nepal.org/heritagegraph/RitualType#NaimittikaPuja> <https://cair-nepal.org/heritagegraph/RitualType#KamyaPuja> <https://cair-nepal.org/heritagegraph/RitualType#Abhisheka> <https://cair-nepal.org/heritagegraph/RitualType#Homa> <https://cair-nepal.org/heritagegraph/RitualType#Bhajan> <https://cair-nepal.org/heritagegraph/RitualType#Yagna> <https://cair-nepal.org/heritagegraph/RitualType#Vrata> <https://cair-nepal.org/heritagegraph/RitualType#Jatra> <https://cair-nepal.org/heritagegraph/RitualType#ChariotProcession> <https://cair-nepal.org/heritagegraph/RitualType#MaskedPerformance> <https://cair-nepal.org/heritagegraph/RitualType#RitualConsecration> <https://cair-nepal.org/heritagegraph/RitualType#ProcessionRitual> <https://cair-nepal.org/heritagegraph/RitualType#InstallationRitual> <https://cair-nepal.org/heritagegraph/RitualType#DeinstallationRitual> <https://cair-nepal.org/heritagegraph/RitualType#ReturningRitual> <https://cair-nepal.org/heritagegraph/RitualType#Circumambulation> <https://cair-nepal.org/heritagegraph/RitualType#RelicTour> <https://cair-nepal.org/heritagegraph/RitualType#ProcessionalMovement> ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path heritageGraph:ritualType ],
        [ sh:class heritageGraph:Festival ;
            sh:description "Larger festival this ritual is part of" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path crm:P9i_forms_part_of ],
        [ sh:class heritageGraph:RitualEvent ;
            sh:description "Points to the next ritual in the canonical sequence." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path crm:P183_ends_before_the_start_of ],
        [ sh:class crm:E57_Material ;
            sh:description "Ephemeral materials consumed during the ritual (e.g., oil, rice)." ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path crm:P125_used_object_of_type ],
        [ sh:class crm:E53_Place ;
            sh:description "Ordered list of places visited during movement ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path heritageGraph:routePlaces ],
        [ sh:datatype xsd:string ;
            sh:description "Text description of the procession route" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path heritageGraph:routeDescription ],
        [ sh:description "Group (Guthi, caste) responsible for ritual" ;
            sh:or ( [ sh:class heritageGraph:Guthi ] [ sh:class heritageGraph:CasteGroup ] ) ;
            sh:order 15 ;
            sh:path heritageGraph:performedByGroup ],
        [ sh:class heritageGraph:DocumentationActivity ;
            sh:description "Documentation event that recorded this (pre-existing) entity or event. Uses heritageGraph:documentedBy (aligned to prov:wasInfluencedBy). NOTE: prov:wasGeneratedBy was incorrect: a stupa is not *generated by* the survey that records it." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path heritageGraph:documentedBy ],
        [ sh:class heritageGraph:RitualEvent ;
            sh:description "Points to the prerequisite ritual." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path crm:P183i_starts_after_the_end_of ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity started." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 31 ;
            sh:path prov:startedAtTime ],
        [ sh:class heritageGraph:KumariSelectionEvent ;
            sh:description "Selection event this assessment is part of." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path heritageGraph:partOfSelection ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor(s) who performed this event" ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path crm:P14_carried_out_by ],
        [ sh:class heritageGraph:Deity ;
            sh:description "Deity invoked or made present through ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path heritageGraph:invokesDeity ],
        [ sh:class prov:Activity ;
            sh:description "Activity that informed this activity; PROV-O uses this when the intervening generated and used entity is unknown or omitted." ;
            sh:nodeKind sh:IRI ;
            sh:order 29 ;
            sh:path prov:wasInformedBy ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Links event to its temporal extent" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path crm:P4_has_time-span ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity ended." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 32 ;
            sh:path prov:endedAtTime ],
        [ sh:datatype xsd:string ;
            sh:description "Frequency of recurring ritual (e.g., annual, monthly)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path heritageGraph:recurrencePattern ],
        [ sh:class prov:Entity ;
            sh:description "Entity generated by this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 27 ;
            sh:path prov:generated ],
        [ sh:class crm:E21_Person ;
            sh:description "Candidate being assessed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path heritageGraph:assessesCandidate ],
        [ sh:class crm:E53_Place ;
            sh:description "Starting location of movement ritual" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 22 ;
            sh:path heritageGraph:startPlace ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text note (description, reason, verification notes)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path crm:P3_has_note ],
        [ sh:class crminf:I2_Belief ;
            sh:description "Provenance-bearing assertion made about this entity or event." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path heritageGraph:hasAssertion ],
        [ sh:class crm:E53_Place ;
            sh:description "Place where the event occurred" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path crm:P7_took_place_at ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor(s) participating in this period, situation or ritual without carrying it out (e.g. the girl holding a Kumari tenure, or the Kumari in a chariot procession)." ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path heritageGraph:hadParticipant ],
        [ sh:class heritageGraph:Guthi ;
            sh:description "Guthi organization managing this structure or ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path heritageGraph:managedByGuthi ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 30 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:class prov:Agent ;
            sh:description "Agent associated with responsibility for this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 28 ;
            sh:path prov:wasAssociatedWith ] ;
    sh:targetClass heritageGraph:FearlessnessAssessment .

heritageGraph:FieldSurveyActivity a sh:NodeShape ;
    sh:description "The activity of measuring, photographing, or assessing a site in person." ;
    sh:property [ sh:class prov:Activity ;
            sh:description "Activity that informed this activity; PROV-O uses this when the intervening generated and used entity is unknown or omitted." ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path prov:wasInformedBy ],
        [ sh:class prov:Agent ;
            sh:description "Agent associated with responsibility for this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:class prov:Entity ;
            sh:description "Entity generated by this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path prov:generated ],
        [ sh:datatype xsd:string ;
            sh:description "Documentation method used" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path heritageGraph:usedMethod ],
        [ sh:class prov:Entity ;
            sh:description "Entity used by this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path prov:used ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:description "Pre-existing heritage entity or event recorded by this documentation activity (inverse of was_documented_by)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:or ( [ sh:class crm:E22_Human-Made_Object ] [ sh:class heritageGraph:ArchitecturalElement ] [ sh:class heritageGraph:Deity ] [ sh:class heritageGraph:ReligiousTradition ] [ sh:class heritageGraph:HistoricalEvent ] [ sh:class heritageGraph:RitualEvent ] [ sh:class crm:E12_Production ] [ sh:class heritageGraph:Consecration ] [ sh:class heritageGraph:Enshrinement ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E39_Actor ] [ sh:class crm:E53_Place ] [ sh:class crm:E52_Time-Span ] [ sh:class heritageGraph:DataSource ] [ sh:class heritageGraph:DocumentationActivity ] [ sh:class heritageGraph:SyncreticRelationship ] [ sh:class heritageGraph:KumariTenure ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E57_Material ] [ sh:class heritageGraph:KumariRole ] [ sh:class heritageGraph:SelectionCriterion ] [ sh:class crminf:I2_Belief ] [ sh:class heritageGraph:CalendarSystem ] ) ;
            sh:order 1 ;
            sh:path heritageGraph:documents ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity ended." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path prov:endedAtTime ],
        [ sh:datatype xsd:string ;
            sh:description "Equipment used in documentation" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path heritageGraph:usedEquipment ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 10 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity started." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path prov:startedAtTime ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dcterms:identifier ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Links event to its temporal extent" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path crm:P4_has_time-span ] ;
    sh:targetClass heritageGraph:FieldSurveyActivity .

heritageGraph:FieldSurveyDataset a sh:NodeShape ;
    sh:description "The structured data or report resulting from a field survey." ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Language of the source material" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path schema1:inLanguage ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 16 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path prov:generatedAtTime ],
        [ sh:datatype xsd:string ;
            sh:description "High-level DataCite resource type (Dataset, Text, Image, Audio, Interview)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path heritageGraph:resourceType ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "When source was published" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path heritageGraph:publicationTimespan ],
        [ sh:class prov:Activity ;
            sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:datatype xsd:string ;
            sh:description "Type of identifier (DOI, ISBN, Handle, LocalArchiveID)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path heritageGraph:identifierScheme ],
        [ sh:datatype xsd:string ;
            sh:description "Persistent identifier for the source (DOI, archive ID, catalog number)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path heritageGraph:persistentIdentifier ],
        [ sh:datatype xsd:string ;
            sh:description "Formal citation of source" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path heritageGraph:sourceCitation ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text note (description, reason, verification notes)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path crm:P3_has_note ],
        [ sh:class crm:E39_Actor ;
            sh:description "Entity responsible for making the source available" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path heritageGraph:sourcePublisher ],
        [ sh:class prov:Entity ;
            sh:description "Entity from which this entity was derived." ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path dcterms:identifier ],
        [ sh:class prov:Agent ;
            sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path prov:wasAttributedTo ],
        [ sh:class crm:E39_Actor ;
            sh:description "Person or organization primarily responsible for creating the source" ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path heritageGraph:sourceCreator ],
        [ sh:datatype xsd:string ;
            sh:description "URL or digital identifier for source" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path heritageGraph:sourceUrl ] ;
    sh:targetClass heritageGraph:FieldSurveyDataset .

heritageGraph:HoroscopeCompatibilityCriterion a sh:NodeShape ;
    sh:description "Candidate's horoscope must be compatible with the city and ruling authority." ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path prov:generatedAtTime ],
        [ sh:class prov:Entity ;
            sh:description "Entity from which this entity was derived." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:class prov:Agent ;
            sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path prov:wasAttributedTo ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 5 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:class prov:Activity ;
            sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:identifier ] ;
    sh:targetClass heritageGraph:HoroscopeCompatibilityCriterion .

heritageGraph:KumariHouse a sh:NodeShape ;
    sh:description "God-house residence of a Kumari during tenure (e.g., Kumari Ghar, Kathmandu). Specialised ReligiousStructure." ;
    sh:property [ sh:class crm:E53_Place ;
            sh:description "Current location of object or structure" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path crm:P55_has_current_location ],
        [ sh:class prov:Activity ;
            sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:class crm:E6_Destruction ;
            sh:description "Event that destroyed this structure (if known)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path heritageGraph:destructionEvent ],
        [ sh:description "Architectural style classification" ;
            sh:in ( <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Pagoda> <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Shikhara> <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Dome> <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Chaitya> <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Stupa> ) ;
            sh:maxCount 1 ;
            sh:order 7 ;
            sh:path heritageGraph:hasArchitecturalStyle ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Latest date when this structure is documented as existing (ISO 8601)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path heritageGraph:lastKnownExistenceDate ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text note (description, reason, verification notes)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path crm:P3_has_note ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path prov:generatedAtTime ],
        [ sh:class crm:E14_Condition_Assessment ;
            sh:description "Condition assessment events for this structure" ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path crm:P34i_was_assessed_by ],
        [ sh:class crm:E53_Place ;
            sh:description "Possible locations if the structure is lost" ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path heritageGraph:hypothesizedLocation ],
        [ sh:class prov:Entity ;
            sh:description "Entity from which this entity was derived." ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:class crm:E10_Transfer_of_Custody ;
            sh:description "Custody transfer events for this structure" ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path crm:P30i_custody_transferred_through ],
        [ sh:class prov:Agent ;
            sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path prov:wasAttributedTo ],
        [ sh:class crminf:I2_Belief ;
            sh:description "Provenance-bearing assertion made about this entity or event." ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path heritageGraph:hasAssertion ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path dcterms:identifier ],
        [ sh:class heritageGraph:DataSource ;
            sh:description "Source(s) that mention/document this entity. Distinct from was_derived_from (which is prov:wasDerivedFrom for assertions). Entity-mention is not logical derivation." ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path heritageGraph:mentionedInSource ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 23 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:class heritageGraph:RitualEvent ;
            sh:description "Rituals in which this structure participates" ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path heritageGraph:participatesInRitual ],
        [ sh:class heritageGraph:DocumentationActivity ;
            sh:description "Documentation event that recorded this (pre-existing) entity or event. Uses heritageGraph:documentedBy (aligned to prov:wasInfluencedBy). NOTE: prov:wasGeneratedBy was incorrect: a stupa is not *generated by* the survey that records it." ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path heritageGraph:documentedBy ],
        [ sh:class heritageGraph:ReligiousTradition ;
            sh:description "Religious tradition(s) within which this deity is venerated, or which use this religious structure" ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path heritageGraph:hasReligiousTradition ],
        [ sh:description "Current physical status of the structure" ;
            sh:in ( <https://cair-nepal.org/heritagegraph/ExistenceStatus#Extant> <https://cair-nepal.org/heritagegraph/ExistenceStatus#PartiallyExtant> <https://cair-nepal.org/heritagegraph/ExistenceStatus#Destroyed> <https://cair-nepal.org/heritagegraph/ExistenceStatus#Lost> <https://cair-nepal.org/heritagegraph/ExistenceStatus#Hypothetical> <https://cair-nepal.org/heritagegraph/ExistenceStatus#Unknown> ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path heritageGraph:existenceStatus ],
        [ sh:class heritageGraph:ArchitecturalElement ;
            sh:description "Architectural elements composing structure" ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path crm:P46_is_composed_of ],
        [ sh:class crm:E12_Production ;
            sh:description "Event that created this object or structure" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path crm:P108i_was_produced_by ],
        [ sh:class heritageGraph:Guthi ;
            sh:description "Guthi organization managing this structure or ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path heritageGraph:managedByGuthi ] ;
    sh:targetClass heritageGraph:KumariHouse .

heritageGraph:LineageCriterion a sh:NodeShape ;
    sh:description "Candidate must belong to an eligible lineage (Shakya / Vajracharya Newar Buddhist family)." ;
    sh:property [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 5 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path prov:generatedAtTime ],
        [ sh:class prov:Agent ;
            sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path prov:wasAttributedTo ],
        [ sh:class prov:Entity ;
            sh:description "Entity from which this entity was derived." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:class prov:Activity ;
            sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:identifier ] ;
    sh:targetClass heritageGraph:LineageCriterion .

heritageGraph:MaskedDance a sh:NodeShape ;
    sh:description "Festival featuring masked dancers embodying deities (e.g., Kartik Naach)" ;
    sh:property [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path dcterms:identifier ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor(s) who performed this event" ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path crm:P14_carried_out_by ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text note (description, reason, verification notes)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path crm:P3_has_note ],
        [ sh:datatype xsd:string ;
            sh:description "Lunar day (Tithi) for ritual timing" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path heritageGraph:lunarDateTithi ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 29 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:class crm:E53_Place ;
            sh:description "Starting location of movement ritual" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path heritageGraph:startPlace ],
        [ sh:class prov:Agent ;
            sh:description "Agent associated with responsibility for this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 27 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:class heritageGraph:Guthi ;
            sh:description "Guthi organization managing this structure or ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path heritageGraph:managedByGuthi ],
        [ sh:datatype xsd:string ;
            sh:description "Text description of the procession route" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path heritageGraph:routeDescription ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor(s) participating in this period, situation or ritual without carrying it out (e.g. the girl holding a Kumari tenure, or the Kumari in a chariot procession)." ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path heritageGraph:hadParticipant ],
        [ sh:class crm:E57_Material ;
            sh:description "Ephemeral materials consumed during the ritual (e.g., oil, rice)." ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path crm:P125_used_object_of_type ],
        [ sh:class crm:E53_Place ;
            sh:description "Ordered list of places visited during movement ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path heritageGraph:routePlaces ],
        [ sh:class heritageGraph:RitualEvent ;
            sh:description "Component rituals of festival" ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path crm:P9_consists_of ],
        [ sh:class heritageGraph:Festival ;
            sh:description "Larger festival this ritual is part of" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path crm:P9i_forms_part_of ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity started." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 30 ;
            sh:path prov:startedAtTime ],
        [ sh:class heritageGraph:DocumentationActivity ;
            sh:description "Documentation event that recorded this (pre-existing) entity or event. Uses heritageGraph:documentedBy (aligned to prov:wasInfluencedBy). NOTE: prov:wasGeneratedBy was incorrect: a stupa is not *generated by* the survey that records it." ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path heritageGraph:documentedBy ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rdfs:label ],
        [ sh:class heritageGraph:RitualEvent ;
            sh:description "Points to the next ritual in the canonical sequence." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path crm:P183_ends_before_the_start_of ],
        [ sh:class prov:Entity ;
            sh:description "Entity used by this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 25 ;
            sh:path prov:used ],
        [ sh:class crm:E53_Place ;
            sh:description "Place where the event occurred" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path crm:P7_took_place_at ],
        [ sh:description "Group (Guthi, caste) responsible for ritual" ;
            sh:or ( [ sh:class heritageGraph:Guthi ] [ sh:class heritageGraph:CasteGroup ] ) ;
            sh:order 12 ;
            sh:path heritageGraph:performedByGroup ],
        [ sh:class crminf:I2_Belief ;
            sh:description "Provenance-bearing assertion made about this entity or event." ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path heritageGraph:hasAssertion ],
        [ sh:class heritageGraph:RitualEvent ;
            sh:description "Points to the prerequisite ritual." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path crm:P183i_starts_after_the_end_of ],
        [ sh:description "Classification of ritual (puja, jatra, consecration)" ;
            sh:in ( <https://cair-nepal.org/heritagegraph/RitualType#NityaPuja> <https://cair-nepal.org/heritagegraph/RitualType#NaimittikaPuja> <https://cair-nepal.org/heritagegraph/RitualType#KamyaPuja> <https://cair-nepal.org/heritagegraph/RitualType#Abhisheka> <https://cair-nepal.org/heritagegraph/RitualType#Homa> <https://cair-nepal.org/heritagegraph/RitualType#Bhajan> <https://cair-nepal.org/heritagegraph/RitualType#Yagna> <https://cair-nepal.org/heritagegraph/RitualType#Vrata> <https://cair-nepal.org/heritagegraph/RitualType#Jatra> <https://cair-nepal.org/heritagegraph/RitualType#ChariotProcession> <https://cair-nepal.org/heritagegraph/RitualType#MaskedPerformance> <https://cair-nepal.org/heritagegraph/RitualType#RitualConsecration> <https://cair-nepal.org/heritagegraph/RitualType#ProcessionRitual> <https://cair-nepal.org/heritagegraph/RitualType#InstallationRitual> <https://cair-nepal.org/heritagegraph/RitualType#DeinstallationRitual> <https://cair-nepal.org/heritagegraph/RitualType#ReturningRitual> <https://cair-nepal.org/heritagegraph/RitualType#Circumambulation> <https://cair-nepal.org/heritagegraph/RitualType#RelicTour> <https://cair-nepal.org/heritagegraph/RitualType#ProcessionalMovement> ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path heritageGraph:ritualType ],
        [ sh:class crm:E53_Place ;
            sh:description "Ending location of movement ritual" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 22 ;
            sh:path heritageGraph:endPlace ],
        [ sh:class prov:Activity ;
            sh:description "Activity that informed this activity; PROV-O uses this when the intervening generated and used entity is unknown or omitted." ;
            sh:nodeKind sh:IRI ;
            sh:order 28 ;
            sh:path prov:wasInformedBy ],
        [ sh:datatype xsd:string ;
            sh:description "Frequency of recurring ritual (e.g., annual, monthly)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path heritageGraph:recurrencePattern ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Links event to its temporal extent" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path crm:P4_has_time-span ],
        [ sh:class prov:Entity ;
            sh:description "Entity generated by this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 26 ;
            sh:path prov:generated ],
        [ sh:description "Ritual occurs at specific temple or monument" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class heritageGraph:ArchitecturalStructure ] [ sh:class heritageGraph:IconographicObject ] [ sh:class heritageGraph:ArchitecturalElement ] ) ;
            sh:order 4 ;
            sh:path crm:P8_took_place_on_or_within ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity ended." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 31 ;
            sh:path prov:endedAtTime ],
        [ sh:class heritageGraph:Deity ;
            sh:description "Deity invoked or made present through ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path heritageGraph:invokesDeity ] ;
    sh:targetClass heritageGraph:MaskedDance .

heritageGraph:OralHistoryInterview a sh:NodeShape ;
    sh:description "The interaction event between a researcher and a knowledge holder." ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Equipment used in documentation" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path heritageGraph:usedEquipment ],
        [ sh:class prov:Entity ;
            sh:description "Entity generated by this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path prov:generated ],
        [ sh:class prov:Agent ;
            sh:description "Agent associated with responsibility for this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:datatype xsd:string ;
            sh:description "Documentation method used" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path heritageGraph:usedMethod ],
        [ sh:class prov:Entity ;
            sh:description "Entity used by this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path prov:used ],
        [ sh:class prov:Activity ;
            sh:description "Activity that informed this activity; PROV-O uses this when the intervening generated and used entity is unknown or omitted." ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path prov:wasInformedBy ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 10 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity ended." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path prov:endedAtTime ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity started." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path prov:startedAtTime ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dcterms:identifier ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Links event to its temporal extent" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path crm:P4_has_time-span ],
        [ sh:description "Pre-existing heritage entity or event recorded by this documentation activity (inverse of was_documented_by)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:or ( [ sh:class crm:E22_Human-Made_Object ] [ sh:class heritageGraph:ArchitecturalElement ] [ sh:class heritageGraph:Deity ] [ sh:class heritageGraph:ReligiousTradition ] [ sh:class heritageGraph:HistoricalEvent ] [ sh:class heritageGraph:RitualEvent ] [ sh:class crm:E12_Production ] [ sh:class heritageGraph:Consecration ] [ sh:class heritageGraph:Enshrinement ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E39_Actor ] [ sh:class crm:E53_Place ] [ sh:class crm:E52_Time-Span ] [ sh:class heritageGraph:DataSource ] [ sh:class heritageGraph:DocumentationActivity ] [ sh:class heritageGraph:SyncreticRelationship ] [ sh:class heritageGraph:KumariTenure ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E57_Material ] [ sh:class heritageGraph:KumariRole ] [ sh:class heritageGraph:SelectionCriterion ] [ sh:class crminf:I2_Belief ] [ sh:class heritageGraph:CalendarSystem ] ) ;
            sh:order 1 ;
            sh:path heritageGraph:documents ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ] ;
    sh:targetClass heritageGraph:OralHistoryInterview .

heritageGraph:OralHistoryRecording a sh:NodeShape ;
    sh:description "The recording or transcript of an oral history interview." ;
    sh:property [ sh:class prov:Activity ;
            sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
