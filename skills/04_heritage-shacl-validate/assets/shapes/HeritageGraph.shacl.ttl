            sh:path heritageGraph:endedTenureOf ],
        [ sh:datatype xsd:string ;
            sh:description "Text description of the procession route" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path heritageGraph:routeDescription ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "When the retirement occurred" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path crm:P4_has_time-span ],
        [ sh:class heritageGraph:KumariTenure ;
            sh:description "The KumariTenure period that this lifecycle event bounds (initiates or terminates). Specialized by initiated_tenure (selection) and ended_tenure_of (retirement)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path heritageGraph:boundsTenure ],
        [ sh:description "Classification of ritual (puja, jatra, consecration)" ;
            sh:in ( <https://cair-nepal.org/heritagegraph/RitualType#NityaPuja> <https://cair-nepal.org/heritagegraph/RitualType#NaimittikaPuja> <https://cair-nepal.org/heritagegraph/RitualType#KamyaPuja> <https://cair-nepal.org/heritagegraph/RitualType#Abhisheka> <https://cair-nepal.org/heritagegraph/RitualType#Homa> <https://cair-nepal.org/heritagegraph/RitualType#Bhajan> <https://cair-nepal.org/heritagegraph/RitualType#Yagna> <https://cair-nepal.org/heritagegraph/RitualType#Vrata> <https://cair-nepal.org/heritagegraph/RitualType#Jatra> <https://cair-nepal.org/heritagegraph/RitualType#ChariotProcession> <https://cair-nepal.org/heritagegraph/RitualType#MaskedPerformance> <https://cair-nepal.org/heritagegraph/RitualType#RitualConsecration> <https://cair-nepal.org/heritagegraph/RitualType#ProcessionRitual> <https://cair-nepal.org/heritagegraph/RitualType#InstallationRitual> <https://cair-nepal.org/heritagegraph/RitualType#DeinstallationRitual> <https://cair-nepal.org/heritagegraph/RitualType#ReturningRitual> <https://cair-nepal.org/heritagegraph/RitualType#Circumambulation> <https://cair-nepal.org/heritagegraph/RitualType#RelicTour> <https://cair-nepal.org/heritagegraph/RitualType#ProcessionalMovement> ) ;
            sh:maxCount 1 ;
            sh:order 10 ;
            sh:path heritageGraph:ritualType ],
        [ sh:class crm:E39_Actor ;
            sh:description "Priests, officials, or groups who performed the retirement ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path crm:P14_carried_out_by ],
        [ sh:datatype xsd:string ;
            sh:description "Lunar day (Tithi) for ritual timing" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path heritageGraph:lunarDateTithi ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor(s) participating in this period, situation or ritual without carrying it out (e.g. the girl holding a Kumari tenure, or the Kumari in a chariot procession)." ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path heritageGraph:hadParticipant ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path dcterms:identifier ],
        [ sh:class crm:E53_Place ;
            sh:description "Where the retirement ceremony occurred" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path crm:P7_took_place_at ],
        [ sh:class prov:Activity ;
            sh:description "Activity that informed this activity; PROV-O uses this when the intervening generated and used entity is unknown or omitted." ;
            sh:nodeKind sh:IRI ;
            sh:order 29 ;
            sh:path prov:wasInformedBy ] ;
    sh:targetClass heritageGraph:KumariRetirementEvent .

heritageGraph:Metadata a sh:NodeShape ;
    sh:description "Dataset metadata information" ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path prov:generatedAtTime ],
        [ sh:datatype xsd:string ;
            sh:description "Version identifier of the dataset instance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path heritageGraph:dataset_version ],
        [ sh:datatype xsd:string ;
            sh:description "HeritageGraph schema version the dataset conforms to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path heritageGraph:schema_version ],
        [ sh:datatype xsd:string ;
            sh:description "Person or organization curating the dataset." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path heritageGraph:curator ],
        [ sh:datatype xsd:string ;
            sh:description "License under which the dataset is released." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path heritageGraph:license ],
        [ sh:class prov:Agent ;
            sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path prov:wasAttributedTo ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Date the dataset serialization was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path heritageGraph:generated_date ],
        [ sh:class prov:Entity ;
            sh:description "Entity from which this entity was derived." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 11 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:class prov:Activity ;
            sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name of the dataset." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path heritageGraph:dataset_name ] ;
    sh:targetClass heritageGraph:Metadata .

heritageGraph:Murti a sh:NodeShape ;
    sh:description "Consecrated statue of a deity, ritually activated to serve as divine presence (not merely depiction)" ;
    sh:property [ sh:class heritageGraph:Consecration ;
            sh:description "Consecration event that activated this murti" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path heritageGraph:consecratedByEvent ],
        [ sh:class crm:E14_Condition_Assessment ;
            sh:description "Condition assessment events for this structure" ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path crm:P34i_was_assessed_by ],
        [ sh:class heritageGraph:Deity ;
            sh:description "Deity depicted iconographically (not cultic presence)" ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path crm:P62_depicts ],
        [ sh:class prov:Entity ;
            sh:description "Entity from which this entity was derived." ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path rdfs:label ],
        [ sh:class prov:Activity ;
            sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 17 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text note (description, reason, verification notes)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path crm:P3_has_note ],
        [ sh:class prov:Agent ;
            sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path prov:wasAttributedTo ],
        [ sh:class heritageGraph:Deity ;
            sh:description "Deity represented and ritually associated with the Murti" ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path heritageGraph:isAboutDeity ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path dcterms:identifier ],
        [ sh:class crm:E53_Place ;
            sh:description "Current location of object or structure" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path crm:P55_has_current_location ],
        [ sh:class crm:E12_Production ;
            sh:description "Event that created this object or structure" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path crm:P108i_was_produced_by ],
        [ sh:class heritageGraph:RitualEvent ;
            sh:description "Rituals in which this structure participates" ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path heritageGraph:participatesInRitual ],
        [ sh:class heritageGraph:DocumentationActivity ;
            sh:description "Documentation event that recorded this (pre-existing) entity or event. Uses heritageGraph:documentedBy (aligned to prov:wasInfluencedBy). NOTE: prov:wasGeneratedBy was incorrect: a stupa is not *generated by* the survey that records it." ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path heritageGraph:documentedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path prov:generatedAtTime ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor(s) who use, handle, or are responsible for this object in ritual contexts" ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path heritageGraph:usedBy ],
        [ sh:class crm:E10_Transfer_of_Custody ;
            sh:description "Custody transfer events for this structure" ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path crm:P30i_custody_transferred_through ] ;
    sh:targetClass heritageGraph:Murti .

heritageGraph:RitualAssessment a sh:NodeShape ;
    sh:description "A performed assessment carried out during Kumari selection. Modelled as an event (not a hard criterion) so that source-specific, possibly conflicting accounts of whether/how it was conducted attach as provenanced Assertions rather than being asserted as fact." ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Frequency of recurring ritual (e.g., annual, monthly)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path heritageGraph:recurrencePattern ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor(s) participating in this period, situation or ritual without carrying it out (e.g. the girl holding a Kumari tenure, or the Kumari in a chariot procession)." ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path heritageGraph:hadParticipant ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path rdfs:label ],
        [ sh:class heritageGraph:DocumentationActivity ;
            sh:description "Documentation event that recorded this (pre-existing) entity or event. Uses heritageGraph:documentedBy (aligned to prov:wasInfluencedBy). NOTE: prov:wasGeneratedBy was incorrect: a stupa is not *generated by* the survey that records it." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path heritageGraph:documentedBy ],
        [ sh:class prov:Entity ;
            sh:description "Entity used by this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 26 ;
            sh:path prov:used ],
        [ sh:class crm:E57_Material ;
            sh:description "Ephemeral materials consumed during the ritual (e.g., oil, rice)." ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path crm:P125_used_object_of_type ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity ended." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 32 ;
            sh:path prov:endedAtTime ],
        [ sh:class heritageGraph:RitualEvent ;
            sh:description "Points to the prerequisite ritual." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path crm:P183i_starts_after_the_end_of ],
        [ sh:class heritageGraph:Deity ;
            sh:description "Deity invoked or made present through ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path heritageGraph:invokesDeity ],
        [ sh:class prov:Agent ;
            sh:description "Agent associated with responsibility for this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 28 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:class heritageGraph:Guthi ;
            sh:description "Guthi organization managing this structure or ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path heritageGraph:managedByGuthi ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor(s) who performed this event" ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path crm:P14_carried_out_by ],
        [ sh:class heritageGraph:Festival ;
            sh:description "Larger festival this ritual is part of" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path crm:P9i_forms_part_of ],
        [ sh:class crm:E21_Person ;
            sh:description "Candidate being assessed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path heritageGraph:assessesCandidate ],
        [ sh:description "Classification of ritual (puja, jatra, consecration)" ;
            sh:in ( <https://cair-nepal.org/heritagegraph/RitualType#NityaPuja> <https://cair-nepal.org/heritagegraph/RitualType#NaimittikaPuja> <https://cair-nepal.org/heritagegraph/RitualType#KamyaPuja> <https://cair-nepal.org/heritagegraph/RitualType#Abhisheka> <https://cair-nepal.org/heritagegraph/RitualType#Homa> <https://cair-nepal.org/heritagegraph/RitualType#Bhajan> <https://cair-nepal.org/heritagegraph/RitualType#Yagna> <https://cair-nepal.org/heritagegraph/RitualType#Vrata> <https://cair-nepal.org/heritagegraph/RitualType#Jatra> <https://cair-nepal.org/heritagegraph/RitualType#ChariotProcession> <https://cair-nepal.org/heritagegraph/RitualType#MaskedPerformance> <https://cair-nepal.org/heritagegraph/RitualType#RitualConsecration> <https://cair-nepal.org/heritagegraph/RitualType#ProcessionRitual> <https://cair-nepal.org/heritagegraph/RitualType#InstallationRitual> <https://cair-nepal.org/heritagegraph/RitualType#DeinstallationRitual> <https://cair-nepal.org/heritagegraph/RitualType#ReturningRitual> <https://cair-nepal.org/heritagegraph/RitualType#Circumambulation> <https://cair-nepal.org/heritagegraph/RitualType#RelicTour> <https://cair-nepal.org/heritagegraph/RitualType#ProcessionalMovement> ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path heritageGraph:ritualType ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 30 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity started." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 31 ;
            sh:path prov:startedAtTime ],
        [ sh:description "Ritual occurs at specific temple or monument" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class heritageGraph:ArchitecturalStructure ] [ sh:class heritageGraph:IconographicObject ] [ sh:class heritageGraph:ArchitecturalElement ] ) ;
            sh:order 9 ;
            sh:path crm:P8_took_place_on_or_within ],
        [ sh:datatype xsd:string ;
            sh:description "Text description of the procession route" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path heritageGraph:routeDescription ],
        [ sh:class crminf:I2_Belief ;
            sh:description "Provenance-bearing assertion made about this entity or event." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path heritageGraph:hasAssertion ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text note (description, reason, verification notes)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path crm:P3_has_note ],
        [ sh:class heritageGraph:RitualEvent ;
            sh:description "Points to the next ritual in the canonical sequence." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path crm:P183_ends_before_the_start_of ],
        [ sh:class prov:Activity ;
            sh:description "Activity that informed this activity; PROV-O uses this when the intervening generated and used entity is unknown or omitted." ;
            sh:nodeKind sh:IRI ;
            sh:order 29 ;
            sh:path prov:wasInformedBy ],
        [ sh:class heritageGraph:KumariSelectionEvent ;
            sh:description "Selection event this assessment is part of." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path heritageGraph:partOfSelection ],
        [ sh:class crm:E53_Place ;
            sh:description "Ordered list of places visited during movement ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path heritageGraph:routePlaces ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path dcterms:identifier ],
        [ sh:class crm:E53_Place ;
            sh:description "Place where the event occurred" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path crm:P7_took_place_at ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Links event to its temporal extent" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path crm:P4_has_time-span ],
        [ sh:class crm:E53_Place ;
            sh:description "Starting location of movement ritual" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 22 ;
            sh:path heritageGraph:startPlace ],
        [ sh:class prov:Entity ;
            sh:description "Entity generated by this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 27 ;
            sh:path prov:generated ],
        [ sh:datatype xsd:string ;
            sh:description "Lunar day (Tithi) for ritual timing" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path heritageGraph:lunarDateTithi ],
        [ sh:class crm:E53_Place ;
            sh:description "Ending location of movement ritual" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 23 ;
            sh:path heritageGraph:endPlace ],
        [ sh:description "Group (Guthi, caste) responsible for ritual" ;
            sh:or ( [ sh:class heritageGraph:Guthi ] [ sh:class heritageGraph:CasteGroup ] ) ;
            sh:order 15 ;
            sh:path heritageGraph:performedByGroup ] ;
    sh:targetClass heritageGraph:RitualAssessment .

heritageGraph:Temple a sh:NodeShape ;
    sh:description "Religious structure characterized by deity enshrinement and ritual activation. Legal designation (e.g. 'Ancient Monument' under Nepal law) is recorded per-instance via a governance assertion, not as a class criterion." ;
    sh:property [ sh:class prov:Agent ;
            sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path prov:wasAttributedTo ],
        [ sh:class prov:Entity ;
            sh:description "Entity from which this entity was derived." ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:description "Current physical status of the structure" ;
            sh:in ( <https://cair-nepal.org/heritagegraph/ExistenceStatus#Extant> <https://cair-nepal.org/heritagegraph/ExistenceStatus#PartiallyExtant> <https://cair-nepal.org/heritagegraph/ExistenceStatus#Destroyed> <https://cair-nepal.org/heritagegraph/ExistenceStatus#Lost> <https://cair-nepal.org/heritagegraph/ExistenceStatus#Hypothetical> <https://cair-nepal.org/heritagegraph/ExistenceStatus#Unknown> ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path heritageGraph:existenceStatus ],
        [ sh:class heritageGraph:DataSource ;
            sh:description "Source(s) that mention/document this entity. Distinct from was_derived_from (which is prov:wasDerivedFrom for assertions). Entity-mention is not logical derivation." ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path heritageGraph:mentionedInSource ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text note (description, reason, verification notes)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path crm:P3_has_note ],
        [ sh:class crm:E53_Place ;
            sh:description "Possible locations if the structure is lost" ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path heritageGraph:hypothesizedLocation ],
        [ sh:class heritageGraph:RitualEvent ;
            sh:description "Rituals in which this structure participates" ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path heritageGraph:participatesInRitual ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 24 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Latest date when this structure is documented as existing (ISO 8601)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path heritageGraph:lastKnownExistenceDate ],
        [ sh:class heritageGraph:Guthi ;
            sh:description "Guthi organization managing this structure or ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path heritageGraph:managedByGuthi ],
        [ sh:class heritageGraph:Enshrinement ;
            sh:description "Enshrinement event that installed deity in temple" ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path heritageGraph:enshrinesDeityThroughEvent ],
        [ sh:class crminf:I2_Belief ;
            sh:description "Provenance-bearing assertion made about this entity or event." ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path heritageGraph:hasAssertion ],
        [ sh:class crm:E12_Production ;
            sh:description "Event that created this object or structure" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path crm:P108i_was_produced_by ],
        [ sh:class heritageGraph:ArchitecturalElement ;
            sh:description "Architectural elements composing structure" ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path crm:P46_is_composed_of ],
        [ sh:class crm:E14_Condition_Assessment ;
            sh:description "Condition assessment events for this structure" ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path crm:P34i_was_assessed_by ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path prov:generatedAtTime ],
        [ sh:class crm:E53_Place ;
            sh:description "Current location of object or structure" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path crm:P55_has_current_location ],
        [ sh:class crm:E6_Destruction ;
            sh:description "Event that destroyed this structure (if known)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path heritageGraph:destructionEvent ],
        [ sh:class crm:E10_Transfer_of_Custody ;
            sh:description "Custody transfer events for this structure" ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path crm:P30i_custody_transferred_through ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path dcterms:identifier ],
        [ sh:class heritageGraph:DocumentationActivity ;
            sh:description "Documentation event that recorded this (pre-existing) entity or event. Uses heritageGraph:documentedBy (aligned to prov:wasInfluencedBy). NOTE: prov:wasGeneratedBy was incorrect: a stupa is not *generated by* the survey that records it." ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path heritageGraph:documentedBy ],
        [ sh:class prov:Activity ;
            sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 22 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:class heritageGraph:ReligiousTradition ;
            sh:description "Religious tradition(s) within which this deity is venerated, or which use this religious structure" ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path heritageGraph:hasReligiousTradition ],
        [ sh:description "Architectural style classification" ;
            sh:in ( <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Pagoda> <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Shikhara> <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Dome> <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Chaitya> <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Stupa> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path heritageGraph:hasArchitecturalStyle ] ;
    sh:targetClass heritageGraph:Temple .

heritageGraph:Proposition a sh:NodeShape ;
    sh:description "A single machine-readable proposition (subject - predicate - object) held true by an Assertion. Modelled as a singleton proposition set (CRMinf I4); the predicate is a URI/CURIE, the object either a heritage entity or a literal." ;
    sh:property [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 9 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:datatype xsd:string ;
            sh:description "Object of the proposition when it is a literal value (e.g. a date)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path heritageGraph:propositionLiteralValue ],
        [ sh:class prov:Entity ;
            sh:description "Entity from which this entity was derived." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:class prov:Agent ;
            sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path prov:wasAttributedTo ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path prov:generatedAtTime ],
        [ sh:class prov:Activity ;
            sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:description "Entity the proposition is about (plays the role of rdf:subject)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:or ( [ sh:class crm:E22_Human-Made_Object ] [ sh:class heritageGraph:ArchitecturalElement ] [ sh:class heritageGraph:Deity ] [ sh:class heritageGraph:ReligiousTradition ] [ sh:class heritageGraph:HistoricalEvent ] [ sh:class heritageGraph:RitualEvent ] [ sh:class crm:E12_Production ] [ sh:class heritageGraph:Consecration ] [ sh:class heritageGraph:Enshrinement ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E39_Actor ] [ sh:class crm:E53_Place ] [ sh:class crm:E52_Time-Span ] [ sh:class heritageGraph:DataSource ] [ sh:class heritageGraph:DocumentationActivity ] [ sh:class heritageGraph:SyncreticRelationship ] [ sh:class heritageGraph:KumariTenure ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E57_Material ] [ sh:class heritageGraph:KumariRole ] [ sh:class heritageGraph:SelectionCriterion ] [ sh:class crminf:I2_Belief ] [ sh:class heritageGraph:CalendarSystem ] ) ;
            sh:order 0 ;
            sh:path heritageGraph:propositionSubject ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dcterms:identifier ],
        [ sh:description "Object of the proposition when it is a heritage entity (plays the role of rdf:object)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:or ( [ sh:class crm:E22_Human-Made_Object ] [ sh:class heritageGraph:ArchitecturalElement ] [ sh:class heritageGraph:Deity ] [ sh:class heritageGraph:ReligiousTradition ] [ sh:class heritageGraph:HistoricalEvent ] [ sh:class heritageGraph:RitualEvent ] [ sh:class crm:E12_Production ] [ sh:class heritageGraph:Consecration ] [ sh:class heritageGraph:Enshrinement ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E39_Actor ] [ sh:class crm:E53_Place ] [ sh:class crm:E52_Time-Span ] [ sh:class heritageGraph:DataSource ] [ sh:class heritageGraph:DocumentationActivity ] [ sh:class heritageGraph:SyncreticRelationship ] [ sh:class heritageGraph:KumariTenure ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E57_Material ] [ sh:class heritageGraph:KumariRole ] [ sh:class heritageGraph:SelectionCriterion ] [ sh:class crminf:I2_Belief ] [ sh:class heritageGraph:CalendarSystem ] ) ;
            sh:order 2 ;
            sh:path heritageGraph:propositionObjectEntity ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Property (URI/CURIE) claimed of the subject, e.g. crm:P108i_was_produced_by (plays the role of rdf:predicate)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path heritageGraph:propositionPredicate ] ;
    sh:targetClass heritageGraph:Proposition .

heritageGraph:KumariSelectionEvent a sh:NodeShape ;
    sh:description "Tantric ritual process of selecting a new Living Goddess from eligible candidates. Involves examination of 32 auspicious physical marks (lakshana), horoscope matching with the city and ruling authority, and tests of fearlessness (e.g., remaining calm among buffalo heads and masked dancers in darkness). Performed by committee of Vajracharya priests, royal priest (Raj Jyotish), and astrologer." ;
    sh:property [ sh:class heritageGraph:Guthi ;
            sh:description "Guthi organization managing this structure or ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path heritageGraph:managedByGuthi ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text note (description, reason, verification notes)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path crm:P3_has_note ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity started." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 35 ;
            sh:path prov:startedAtTime ],
        [ sh:class crminf:I2_Belief ;
            sh:description "Provenance-bearing assertion made about this entity or event." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path heritageGraph:hasAssertion ],
        [ sh:datatype xsd:string ;
            sh:description "Lunar day (Tithi) for ritual timing" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path heritageGraph:lunarDateTithi ],
        [ sh:class heritageGraph:Festival ;
            sh:description "Larger festival this ritual is part of" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path crm:P9i_forms_part_of ],
        [ sh:class heritageGraph:KumariTenure ;
            sh:description "Living Goddess tenure that this selection event initiated" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path heritageGraph:initiatedTenure ],
        [ sh:class crm:E21_Person ;
            sh:description "Girl selected to become Living Goddess" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path heritageGraph:selectedPerson ],
        [ sh:class heritageGraph:Deity ;
            sh:description "Deity invoked or made present through ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path heritageGraph:invokesDeity ],
        [ sh:description "Ritual occurs at specific temple or monument" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class heritageGraph:ArchitecturalStructure ] [ sh:class heritageGraph:IconographicObject ] [ sh:class heritageGraph:ArchitecturalElement ] ) ;
            sh:order 15 ;
            sh:path crm:P8_took_place_on_or_within ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 34 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:class heritageGraph:KumariTenure ;
            sh:description "The KumariTenure period that this lifecycle event bounds (initiates or terminates). Specialized by initiated_tenure (selection) and ended_tenure_of (retirement)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path heritageGraph:boundsTenure ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor(s) who performed this event" ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path crm:P14_carried_out_by ],
        [ sh:class heritageGraph:KumariRole ;
            sh:description "KumariRole conferred by this selection or enthronement event." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path heritageGraph:confersRole ],
        [ sh:class prov:Entity ;
            sh:description "Entity generated by this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 31 ;
            sh:path prov:generated ],
        [ sh:class prov:Entity ;
            sh:description "Entity used by this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 30 ;
            sh:path prov:used ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity ended." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 36 ;
            sh:path prov:endedAtTime ],
        [ sh:class heritageGraph:RitualEvent ;
            sh:description "Points to the prerequisite ritual." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 23 ;
            sh:path crm:P183i_starts_after_the_end_of ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether this ritual is essential for the festival's completion" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path heritageGraph:isCriticalForFestival ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor(s) participating in this period, situation or ritual without carrying it out (e.g. the girl holding a Kumari tenure, or the Kumari in a chariot procession)." ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path heritageGraph:hadParticipant ],
        [ sh:class crm:E53_Place ;
            sh:description "Ending location of movement ritual" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 27 ;
            sh:path heritageGraph:endPlace ],
        [ sh:class crm:E53_Place ;
            sh:description "Place where the event occurred" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path crm:P7_took_place_at ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 29 ;
            sh:path dcterms:identifier ],
        [ sh:class heritageGraph:RitualEvent ;
            sh:description "Points to the next ritual in the canonical sequence." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 22 ;
            sh:path crm:P183_ends_before_the_start_of ],
        [ sh:class heritageGraph:SelectionCriterion ;
            sh:description "Eligibility criterion applied in this selection." ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path heritageGraph:hasCriterion ],
        [ sh:datatype xsd:string ;
            sh:description "Frequency of recurring ritual (e.g., annual, monthly)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path heritageGraph:recurrencePattern ],
        [ sh:class prov:Agent ;
            sh:description "Agent associated with responsibility for this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 32 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Links event to its temporal extent" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path crm:P4_has_time-span ],
        [ sh:datatype xsd:string ;
            sh:description "Name of selection event" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:class prov:Activity ;
            sh:description "Activity that informed this activity; PROV-O uses this when the intervening generated and used entity is unknown or omitted." ;
            sh:nodeKind sh:IRI ;
            sh:order 33 ;
            sh:path prov:wasInformedBy ],
        [ sh:class crm:E57_Material ;
            sh:description "Ephemeral materials consumed during the ritual (e.g., oil, rice)." ;
            sh:nodeKind sh:IRI ;
            sh:order 24 ;
            sh:path crm:P125_used_object_of_type ],
        [ sh:class crm:E53_Place ;
            sh:description "Ordered list of places visited during movement ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 25 ;
            sh:path heritageGraph:routePlaces ],
        [ sh:class heritageGraph:DocumentationActivity ;
            sh:description "Documentation event that recorded this (pre-existing) entity or event. Uses heritageGraph:documentedBy (aligned to prov:wasInfluencedBy). NOTE: prov:wasGeneratedBy was incorrect: a stupa is not *generated by* the survey that records it." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path heritageGraph:documentedBy ],
        [ sh:datatype xsd:string ;
            sh:description "Text description of the procession route" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 28 ;
            sh:path heritageGraph:routeDescription ],
        [ sh:description "Group (Guthi, caste) responsible for ritual" ;
            sh:or ( [ sh:class heritageGraph:Guthi ] [ sh:class heritageGraph:CasteGroup ] ) ;
            sh:order 5 ;
            sh:path heritageGraph:performedByGroup ],
        [ sh:class crm:E53_Place ;
            sh:description "Starting location of movement ritual" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 26 ;
            sh:path heritageGraph:startPlace ],
        [ sh:description "Classification of ritual (puja, jatra, consecration)" ;
            sh:in ( <https://cair-nepal.org/heritagegraph/RitualType#NityaPuja> <https://cair-nepal.org/heritagegraph/RitualType#NaimittikaPuja> <https://cair-nepal.org/heritagegraph/RitualType#KamyaPuja> <https://cair-nepal.org/heritagegraph/RitualType#Abhisheka> <https://cair-nepal.org/heritagegraph/RitualType#Homa> <https://cair-nepal.org/heritagegraph/RitualType#Bhajan> <https://cair-nepal.org/heritagegraph/RitualType#Yagna> <https://cair-nepal.org/heritagegraph/RitualType#Vrata> <https://cair-nepal.org/heritagegraph/RitualType#Jatra> <https://cair-nepal.org/heritagegraph/RitualType#ChariotProcession> <https://cair-nepal.org/heritagegraph/RitualType#MaskedPerformance> <https://cair-nepal.org/heritagegraph/RitualType#RitualConsecration> <https://cair-nepal.org/heritagegraph/RitualType#ProcessionRitual> <https://cair-nepal.org/heritagegraph/RitualType#InstallationRitual> <https://cair-nepal.org/heritagegraph/RitualType#DeinstallationRitual> <https://cair-nepal.org/heritagegraph/RitualType#ReturningRitual> <https://cair-nepal.org/heritagegraph/RitualType#Circumambulation> <https://cair-nepal.org/heritagegraph/RitualType#RelicTour> <https://cair-nepal.org/heritagegraph/RitualType#ProcessionalMovement> ) ;
            sh:maxCount 1 ;
            sh:order 14 ;
            sh:path heritageGraph:ritualType ] ;
    sh:targetClass heritageGraph:KumariSelectionEvent .

crm:E21_Person a sh:NodeShape ;
    sh:description "Individual person who performs, commissions, documents, or verifies heritage activities" ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Areas of expertise (e.g., Lichhavi inscriptions, Sanskrit epigraphy, Newari archaeology)" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path heritageGraph:expertiseArea ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:description "Institutional affiliation (e.g., Tribhuvan University, Nepal Heritage Society)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path heritageGraph:institutionalAffiliation ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Person's death timespan" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path heritageGraph:deathTimespan ],
        [ sh:class heritageGraph:Guthi ;
            sh:description "Groups this person belongs to" ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path crm:P107i_is_current_or_former_member_of ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text note (description, reason, verification notes)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path crm:P3_has_note ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 10 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:class heritageGraph:RitualEvent ;
            sh:description "Activities performed by this actor" ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path crm:P14i_performed ],
        [ sh:class prov:Agent ;
            sh:description "Agent on whose behalf this agent acted." ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path prov:actedOnBehalfOf ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Person's birth timespan" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path heritageGraph:birthTimespan ] ;
    sh:targetClass crm:E21_Person .

crm:E22_Human-Made_Object a sh:NodeShape ;
    sh:description "Physical objects created by human activity" ;
    sh:property [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 12 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:class crm:E53_Place ;
            sh:description "Current location of object or structure" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path crm:P55_has_current_location ],
        [ sh:class crm:E12_Production ;
            sh:description "Event that created this object or structure" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path crm:P108i_was_produced_by ],
        [ sh:class prov:Entity ;
            sh:description "Entity from which this entity was derived." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:class crm:E10_Transfer_of_Custody ;
            sh:description "Custody transfer events for this structure" ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path crm:P30i_custody_transferred_through ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rdfs:label ],
        [ sh:class heritageGraph:RitualEvent ;
            sh:description "Rituals in which this structure participates" ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path heritageGraph:participatesInRitual ],
        [ sh:class prov:Agent ;
            sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path prov:wasAttributedTo ],
        [ sh:class heritageGraph:DocumentationActivity ;
            sh:description "Documentation event that recorded this (pre-existing) entity or event. Uses heritageGraph:documentedBy (aligned to prov:wasInfluencedBy). NOTE: prov:wasGeneratedBy was incorrect: a stupa is not *generated by* the survey that records it." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path heritageGraph:documentedBy ],
        [ sh:class crm:E14_Condition_Assessment ;
            sh:description "Condition assessment events for this structure" ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path crm:P34i_was_assessed_by ],
        [ sh:class prov:Activity ;
            sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path prov:generatedAtTime ] ;
    sh:targetClass crm:E22_Human-Made_Object .

heritageGraph:HistoricalEvent a sh:NodeShape ;
    sh:description "Major event affecting heritage structures or ritual life (earthquake, epidemic, political transition, fire, flood)." ;
    sh:property [ sh:class heritageGraph:ArchitecturalStructure ;
            sh:description "Heritage structures affected by or present during this historical event" ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path heritageGraph:architecturalStructures ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text note (description, reason, verification notes)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path crm:P3_has_note ],
        [ sh:class prov:Agent ;
            sh:description "Agent associated with responsibility for this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Links event to its temporal extent" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path crm:P4_has_time-span ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity ended." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path prov:endedAtTime ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dcterms:identifier ],
        [ sh:class prov:Entity ;
            sh:description "Entity used by this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path prov:used ],
        [ sh:class prov:Entity ;
            sh:description "Entity generated by this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path prov:generated ],
        [ sh:class prov:Activity ;
            sh:description "Activity that informed this activity; PROV-O uses this when the intervening generated and used entity is unknown or omitted." ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path prov:wasInformedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity started." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path prov:startedAtTime ],
        [ sh:class heritageGraph:RitualEvent ;
            sh:description "Component rituals of festival" ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path crm:P9_consists_of ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 11 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:class crm:E53_Place ;
            sh:description "Place where the event occurred" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path crm:P7_took_place_at ] ;
    sh:targetClass heritageGraph:HistoricalEvent .

heritageGraph:SyncreticRelationship a sh:NodeShape ;
    sh:description "Formalizes the syncretic equivalence between divine entities across different theological frameworks. Following CIDOC CRM E13, it treats syncretism as a propositional claim with associated epistemic authority and provenance." ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity started." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path prov:startedAtTime ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path dcterms:identifier ],
        [ sh:description "The typological nature of the syncretism (e.g., Ontological Identity, Functional Overlap, Iconographic Similarity)." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/SyncreticType#Equivalence> <https://cair-nepal.org/heritagegraph/SyncreticType#Appropriation> <https://cair-nepal.org/heritagegraph/SyncreticType#Fusion> <https://cair-nepal.org/heritagegraph/SyncreticType#Historical> ) ;
            sh:maxCount 1 ;
            sh:order 4 ;
            sh:path heritageGraph:syncreticType ],
        [ sh:class prov:Agent ;
            sh:description "Agent associated with responsibility for this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:class prov:Entity ;
            sh:description "Entity generated by this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path prov:generated ],
        [ sh:class heritageGraph:DocumentationActivity ;
            sh:description "Documentation event that recorded this (pre-existing) entity or event. Uses heritageGraph:documentedBy (aligned to prov:wasInfluencedBy). NOTE: prov:wasGeneratedBy was incorrect: a stupa is not *generated by* the survey that records it." ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path heritageGraph:documentedBy ],
        [ sh:class prov:Activity ;
            sh:description "Activity that informed this activity; PROV-O uses this when the intervening generated and used entity is unknown or omitted." ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path prov:wasInformedBy ],
        [ sh:class prov:Entity ;
            sh:description "Entity used by this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path prov:used ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text note (description, reason, verification notes)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path crm:P3_has_note ],
        [ sh:class heritageGraph:DataSource ;
            sh:description "Source(s) that mention/document this entity. Distinct from was_derived_from (which is prov:wasDerivedFrom for assertions). Entity-mention is not logical derivation." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path heritageGraph:mentionedInSource ],
        [ sh:class heritageGraph:Deity ;
            sh:description "The deity instance that is the subject of the syncretic claim." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path crm:P140_assigned_attribute_to ],
        [ sh:class heritageGraph:Deity ;
            sh:description "The deity or sacred figure being identified as equivalent to the primary deity." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path crm:P141_assigned ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 12 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity ended." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path prov:endedAtTime ] ;
    sh:targetClass heritageGraph:SyncreticRelationship .

crm:E29_Design_or_Procedure a sh:NodeShape ;
    sh:description "Method or craft process used in production or ritual" ;
    sh:property [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 7 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:class prov:Entity ;
            sh:description "Entity from which this entity was derived." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:class prov:Activity ;
            sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:class prov:Agent ;
            sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path prov:wasAttributedTo ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path prov:generatedAtTime ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text note (description, reason, verification notes)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path crm:P3_has_note ] ;
    sh:targetClass crm:E29_Design_or_Procedure .

crm:E3_Condition_State a sh:NodeShape ;
    sh:description "A physical condition state of a heritage object" ;
    sh:property [ sh:class prov:Activity ;
            sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
