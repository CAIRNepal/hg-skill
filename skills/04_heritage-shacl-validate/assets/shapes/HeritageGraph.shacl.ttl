heritageGraph:KumariTenure a sh:NodeShape ;
    sh:description "Time-bounded role where a person embodies a deity as Living Goddess (Kumari), residing at a specific god-house and supported by religious institutions. This class captures the unique Nepali tradition of living deity embodiment in young girls selected from Buddhist Shakya/Vajracharya families." ;
    sh:property [ sh:class heritageGraph:KumariRole ;
            sh:description "KumariRole held during this tenure." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path heritageGraph:assumesRole ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 16 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:class crm:E21_Person ;
            sh:description "The girl serving as Living Goddess during this period" ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path heritageGraph:hadParticipant ],
        [ sh:class heritageGraph:Guthi ;
            sh:description "Guthi or state body providing economic/ritual support during tenure" ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path heritageGraph:supportedByInstitution ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Duration of Living Goddess tenure (from selection to retirement)" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path crm:P4_has_time-span ],
        [ sh:class prov:Entity ;
            sh:description "Entity from which this entity was derived." ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path prov:generatedAtTime ],
        [ sh:class heritageGraph:KumariRetirementEvent ;
            sh:description "Retirement/desanctification event that ended this tenure." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path heritageGraph:retiredThrough ],
        [ sh:class heritageGraph:DocumentationActivity ;
            sh:description "Documentation event that recorded this (pre-existing) entity or event. Uses heritageGraph:documentedBy (aligned to prov:wasInfluencedBy). NOTE: prov:wasGeneratedBy was incorrect: a stupa is not *generated by* the survey that records it." ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path heritageGraph:documentedBy ],
        [ sh:class prov:Agent ;
            sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path prov:wasAttributedTo ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path dcterms:identifier ],
        [ sh:class prov:Activity ;
            sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:datatype xsd:string ;
            sh:description "Name of this tenure period (e.g., 'Kumari Samita Bajracharya Tenure 2015-2023')" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:class heritageGraph:KumariSelectionEvent ;
            sh:description "Selection event that initiated this tenure." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path heritageGraph:selectedThrough ],
        [ sh:class heritageGraph:ArchitecturalStructure ;
            sh:description "God-house where Living Goddess resides (e.g., Kumari Ghar)" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path heritageGraph:residenceStructure ],
        [ sh:class heritageGraph:Deity ;
