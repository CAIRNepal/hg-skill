            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path prov:wasAttributedTo ],
        [ sh:class crm:E39_Actor ;
            sh:description "Person or organization primarily responsible for creating the source" ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path heritageGraph:sourceCreator ],
        [ sh:class heritageGraph:DocumentationActivity ;
            sh:description "Documentation event that recorded this (pre-existing) entity or event. Uses heritageGraph:documentedBy (aligned to prov:wasInfluencedBy). NOTE: prov:wasGeneratedBy was incorrect: a stupa is not *generated by* the survey that records it." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path heritageGraph:documentedBy ],
        [ sh:class prov:Entity ;
            sh:description "Entity from which this entity was derived." ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text note (description, reason, verification notes)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path crm:P3_has_note ],
        [ sh:class crm:E39_Actor ;
            sh:description "Entity responsible for making the source available" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path heritageGraph:sourcePublisher ],
        [ sh:datatype xsd:string ;
            sh:description "Type of identifier (DOI, ISBN, Handle, LocalArchiveID)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path heritageGraph:identifierScheme ],
        [ sh:datatype xsd:string ;
            sh:description "Language of the source material" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path schema1:inLanguage ],
        [ sh:datatype xsd:string ;
            sh:description "Persistent identifier for the source (DOI, archive ID, catalog number)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path heritageGraph:persistentIdentifier ],
        [ sh:datatype xsd:string ;
            sh:description "Formal citation of source" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path heritageGraph:sourceCitation ],
        [ sh:description "Heritage entity or event described by this information object." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:or ( [ sh:class crm:E22_Human-Made_Object ] [ sh:class heritageGraph:ArchitecturalElement ] [ sh:class heritageGraph:Deity ] [ sh:class heritageGraph:ReligiousTradition ] [ sh:class heritageGraph:HistoricalEvent ] [ sh:class heritageGraph:RitualEvent ] [ sh:class crm:E12_Production ] [ sh:class heritageGraph:Consecration ] [ sh:class heritageGraph:Enshrinement ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E39_Actor ] [ sh:class crm:E53_Place ] [ sh:class crm:E52_Time-Span ] [ sh:class heritageGraph:DataSource ] [ sh:class heritageGraph:DocumentationActivity ] [ sh:class heritageGraph:SyncreticRelationship ] [ sh:class heritageGraph:KumariTenure ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E57_Material ] [ sh:class heritageGraph:KumariRole ] [ sh:class heritageGraph:SelectionCriterion ] [ sh:class crminf:I2_Belief ] [ sh:class heritageGraph:CalendarSystem ] ) ;
            sh:order 1 ;
