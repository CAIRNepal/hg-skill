            sh:description "Entity from which this entity was derived." ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:class prov:Agent ;
            sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path prov:wasAttributedTo ],
        [ sh:class crm:E53_Place ;
            sh:description "Possible locations if the structure is lost" ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path heritageGraph:hypothesizedLocation ],
        [ sh:class heritageGraph:ArchitecturalElement ;
            sh:description "Architectural elements composing structure" ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path crm:P46_is_composed_of ],
        [ sh:class crm:E14_Condition_Assessment ;
            sh:description "Condition assessment events for this structure" ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path crm:P34i_was_assessed_by ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rdfs:label ],
        [ sh:class heritageGraph:DocumentationActivity ;
            sh:description "Documentation event that recorded this (pre-existing) entity or event. Uses heritageGraph:documentedBy (aligned to prov:wasInfluencedBy). NOTE: prov:wasGeneratedBy was incorrect: a stupa is not *generated by* the survey that records it." ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path heritageGraph:documentedBy ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path dcterms:identifier ],
        [ sh:class heritageGraph:Guthi ;
            sh:description "Guthi organization managing this structure or ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path heritageGraph:managedByGuthi ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 23 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:class crm:E10_Transfer_of_Custody ;
            sh:description "Custody transfer events for this structure" ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path crm:P30i_custody_transferred_through ],
        [ sh:class heritageGraph:DataSource ;
            sh:description "Source(s) that mention/document this entity. Distinct from was_derived_from (which is prov:wasDerivedFrom for assertions). Entity-mention is not logical derivation." ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path heritageGraph:mentionedInSource ],
        [ sh:class crm:E6_Destruction ;
            sh:description "Event that destroyed this structure (if known)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path heritageGraph:destructionEvent ],
        [ sh:class crm:E12_Production ;
            sh:description "Event that created this object or structure" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path crm:P108i_was_produced_by ],
        [ sh:class heritageGraph:ReligiousTradition ;
            sh:description "Religious tradition(s) within which this deity is venerated, or which use this religious structure" ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path heritageGraph:hasReligiousTradition ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path prov:generatedAtTime ],
        [ sh:class crm:E53_Place ;
