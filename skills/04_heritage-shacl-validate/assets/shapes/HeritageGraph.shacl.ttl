            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:identifier ],
        [ sh:class heritageGraph:Deity ;
            sh:description "Deity embodied by whoever holds this role (e.g., Taleju)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path heritageGraph:roleDeity ] ;
    sh:targetClass heritageGraph:KumariRole .

