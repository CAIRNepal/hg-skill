            sh:order 8 ;
            sh:path prov:generated ],
        [ sh:class prov:Entity ;
            sh:description "Entity used by this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path prov:used ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 11 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity ended." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path prov:endedAtTime ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor(s) who performed this event" ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path crm:P14_carried_out_by ],
        [ sh:class prov:Agent ;
            sh:description "Agent associated with responsibility for this activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
