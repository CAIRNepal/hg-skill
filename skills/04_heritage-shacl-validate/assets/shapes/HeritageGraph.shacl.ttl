            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path heritageGraph:embodiedDeity ],
        [ sh:class heritageGraph:KumariEnthronementEvent ;
